# Переменные сайта и сервиса чата. На сервере лежат в /srv/shkatova-psychologist/.env, в git не попадают.

# Телефон Татьяны, только цифры: 7XXXXXXXXXX. Нужен и сборке сайта, и чату.
CONTACT_PHONE=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Бот из @BotFather и чаты, куда он шлёт выжимки: один или несколько id через запятую.
# Каждый получатель сначала пишет боту /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Потолок запросов к модели за сутки на весь сервис, по умолчанию 1000.
# Вдобавок стоит задать лимит кредитов на сам ключ в настройках OpenRouter.
CHAT_DAILY_LIMIT=
