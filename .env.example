# Секреты сервиса чата. На сервере лежат в /srv/shkatova-site/.env, в git не попадают.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Бот из @BotFather и чаты, куда он шлёт выжимки: один или несколько id через запятую.
# Каждый получатель сначала пишет боту /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
