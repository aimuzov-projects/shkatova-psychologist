# Блок для общего Caddy проекта skator: deploy.sh кладёт файл в /opt/caddy/sites/,
# Caddyfile skator импортирует эту папку и при своём деплое её не трогает.

tanya.aimuzov.online {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Пока на сайте заглушки вместо реальных данных -- в поиск не отдаём.
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy shkatova-site:80

	log {
		output file /data/shkatova.log {
			roll_size 5MiB
			roll_keep 2
		}
	}
}
