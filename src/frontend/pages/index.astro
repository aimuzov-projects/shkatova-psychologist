---
import Base from '#frontend/layouts/base.astro'
import Header from '#frontend/components/header.astro'
import Story from '#frontend/components/story.astro'
import Hero from '#frontend/components/hero.astro'
import About from '#frontend/components/about.astro'
import Topics from '#frontend/components/topics.astro'
import Services from '#frontend/components/services.astro'
import Materials from '#frontend/components/materials.astro'
import Faq from '#frontend/components/faq.astro'
import Contacts from '#frontend/components/contacts.astro'
import Footer from '#frontend/components/footer.astro'
import StructuredData from '#frontend/components/structured-data.astro'
import hero from '#frontend/assets/hero.jpg'
import about from '#frontend/assets/about.jpg'
import services from '#frontend/assets/services.jpg'
import reading from '#frontend/assets/topics.jpg'
---

<Base>
	<StructuredData slot="head" />
	<Header />
	<main>
		<Story
			eager
			shots={[
				{ src: hero },
				{ src: about, trigger: '#about .eyebrow', at: 260 },
				{ src: reading, trigger: '#topics .eyebrow', at: 260 },
				{ src: services, trigger: '#services .eyebrow', at: 260 },
			]}
		>
			<Hero />
			<About />
			<Topics />
			<Services />
			<Materials />
			<Faq />
		</Story>
		<Contacts />
	</main>
	<Footer scenery />
</Base>
