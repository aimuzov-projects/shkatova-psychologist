---
import NotFound from '@aimuzov-projects/infra-site-kit/not-found.astro'
import Base from '#frontend/layouts/base.astro'
import Footer from '#frontend/components/footer.astro'
import Header from '#frontend/components/header.astro'
import Icon from '#frontend/components/icon.astro'
import { person } from '#shared/site.ts'
---

<Base title={`Страница не найдена — ${person.name}`} description="Такой страницы на сайте нет." index={false}>
	<Header home={false} />
	<main class="missing" data-stage="night">
		<NotFound text="Возможно, ссылка устарела или в ней опечатка. Загляните на главную или напишите мне — отвечу в течение дня.">
			<a slot="actions" href="/#contacts" class="not-found__action">
				<Icon name="plane" size={18} />
				Контакты
			</a>
		</NotFound>
	</main>
	<Footer stage="night" />
</Base>

<style>
	/* Кит берёт цвета ночной сцены и круглые кнопки сайта. */
	.missing {
		--not-found-accent: var(--accent);
		--not-found-muted: var(--muted);
		--not-found-radius: 999px;

		display: grid;
		align-items: center;
		min-height: calc(100svh - 120px);
		padding-block: calc(var(--section-y) + 64px) var(--section-y);

		& :global(.not-found__action) {
			gap: 0.6em;
		}
	}
</style>
