---
import Icon from '#frontend/components/icon.astro'
import { materials, type MaterialBlock } from '#frontend/data/materials.ts'

// Превью памятки -- первый слайд в двух-трёх строках: заголовок и пара пунктов из него.
const previewItems = (block: MaterialBlock) => {
	switch (block.type) {
		case 'phrases':
		case 'replies':
			return block.items.slice(0, 2)
		case 'dont-do':
			return [
				{ label: block.dontLabel, text: block.items[0].dont },
				{ label: block.doLabel, text: block.items[0].do },
			]
		case 'formula':
			// {N:текст} в примерах -- разметка подсветки слотов, в превью она не нужна.
			return [{ label: block.examplesTitle, text: block.examples[0].replace(/\{\d+:([^}]*)\}/g, '$1') }]
	}
}
---

<section class="section" id="materials" data-stage="rose">
	<div class="container story__text">
		<span class="eyebrow reveal">Бесплатные материалы</span>
		<h2 class="reveal" data-delay="1">
			Слова, на которые можно опереться
		</h2>
		<p class="lead reveal" data-delay="2">
			Короткие памятки для тех, кто переживает потерю беременности, и для их близких. Открываются прямо на сайте,
			с телефона удобно.
		</p>

		<ul class="materials soft-divide">
			{materials.map((m, i) => (
				<li class="materials__item reveal" data-delay={String(i)}>
					<a href={`/materials/${m.slug}/`} class="material">
						<span class="material__icon">
							<Icon name={m.icon} size={28} />
						</span>
						<span class="material__body">
							<span class="material__audience">{m.audience}</span>
							<span class="material__title">{m.title}</span>
							<span class="material__text muted">{m.short}</span>
							<span class="btn btn--ghost material__btn">
								Открыть памятку
								<Icon name="arrow-out" class="material__arrow" size={18} />
							</span>
						</span>
					</a>
					<div class="preview" aria-hidden="true">
						<div class="preview__card">
							<span class="preview__audience">{m.audience}</span>
							<span class="preview__title">{m.title}</span>
							<span class="preview__block">{m.blocks[0].title}</span>
							{previewItems(m.blocks[0]).map((item) => (
								<span class="preview__item">
									<span class="preview__label">{item.label}</span>
									<span class="preview__text">{item.text}</span>
								</span>
							))}
						</div>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.materials {
		margin: 40px 0 0;
		padding: 0;
		list-style: none;
	}

	.material {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 12px 16px;
		align-items: start;
		margin-inline: -12px;
		padding: 26px 12px;
		border-radius: 12px;
		text-decoration: none;
		transition: background-color 0.4s var(--ease);

		&:hover,
		&:focus-visible {
			background: color-mix(in srgb, var(--accent) 10%, transparent);
		}

		&__icon {
			display: grid;
			place-items: center;
			width: 52px;
			height: 52px;
			border-radius: 50%;
			color: var(--accent);
			background: color-mix(in srgb, var(--accent) 12%, transparent);
			transition:
				color 1.4s var(--ease),
				background-color 1.4s var(--ease);
		}

		&__body {
			display: flex;
			flex-direction: column;
			gap: 6px;
		}

		&__audience {
			font-size: 0.74rem;
			font-weight: 500;
			color: var(--accent);
			text-transform: uppercase;
			letter-spacing: 0.18em;
			transition: color 1.4s var(--ease);
		}

		&__title {
			font-family: var(--font-serif);
			font-size: 1.45rem;
			line-height: 1.2;
		}

		&__text {
			max-width: 48ch;
			font-size: 0.95rem;
		}

		/* Кнопка внутри ссылки-карточки: кликается вся карточка, кнопка показывает, что это переход. */
		&__btn {
			align-self: flex-start;
			margin-top: 10px;
			padding: 0.7em 1.4em;
			font-size: 0.88rem;
		}

		&:hover &__btn,
		&:focus-visible &__btn {
			background: color-mix(in srgb, var(--fg) 12%, transparent);
			box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 40%, transparent);
		}

		& :global(.material__arrow) {
			color: var(--accent);
			transition: transform 0.5s var(--ease);
		}

		&:hover :global(.material__arrow),
		&:focus-visible :global(.material__arrow) {
			transform: translate(3px, -3px);
		}
	}

	/* Превью памятки на месте фото в колонке Story: проявляется, пока курсор над карточкой.
	   Только на десктопе с мышью -- на телефоне колонки нет, а наведения не бывает. */
	.preview {
		display: none;

		@media (--md) and (hover: hover) {
			pointer-events: none;
			position: fixed;
			z-index: 4;
			inset: 0 0 0 auto;
			display: grid;
			place-items: center;
			width: 46vw;
			padding: 96px clamp(40px, 6vw, 96px) 48px;
			visibility: hidden;
			opacity: 0;
			transition:
				opacity 0.5s var(--ease),
				visibility 0s 0.5s;

			@media (--reduced-motion) {
				transition: none;
			}
		}

		/* Подложка отдельным слоем: маска с широким переходом слева гасила бы и текст.
		   Тон ночи с верха страницы, полупрозрачный -- фото колонки просвечивает. Не через
		   data-stage: за ним следит скрипт стадий и перекрасил бы всю страницу. */
		&::before {
			@media (--md) and (hover: hover) {
				content: '';
				position: absolute;
				z-index: -1;
				inset: 0;
				background: rgb(33 19 32 / 0.45);
				mask-image: linear-gradient(to right, transparent 0%, #000 45%);
			}
		}

		/* Появляется с задержкой, чтобы не мигать, когда курсор просто проходит через список.
		   Гаснет сразу: задержка есть только у появления. */
		.materials__item:hover > &,
		.material:focus-visible + & {
			visibility: visible;
			opacity: 1;
			transition:
				opacity 0.5s var(--ease) 0.35s,
				visibility 0s 0.35s;
		}

		&__card {
			display: flex;
			flex-direction: column;
			gap: 14px;
			max-width: 30rem;
		}

		&__audience {
			font-size: 0.74rem;
			font-weight: 500;
			color: var(--accent);
			text-transform: uppercase;
			letter-spacing: 0.18em;
		}

		&__title {
			font-family: var(--font-serif);
			font-size: clamp(1.6rem, 2.4vw, 2.2rem);
			line-height: 1.15;
		}

		&__block {
			margin-top: 18px;
			padding-top: 18px;
			border-top: 1px solid var(--line);
			font-size: 0.82rem;
			color: var(--muted);
		}

		&__item {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		&__label {
			font-size: 0.82rem;
			color: var(--accent);
		}

		&__text {
			font-family: var(--font-serif);
			font-size: 1.12rem;
			line-height: 1.35;
		}
	}
</style>
