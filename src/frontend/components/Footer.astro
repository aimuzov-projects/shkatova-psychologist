---
import { Picture } from 'astro:assets'

import mountains from '#frontend/assets/mountains.jpg'
import { contacts, person } from '#shared/site.ts'

type Props = {
	/** `data-stage` футера, по умолчанию `day`. Вне главной -- как у страницы, иначе фон перекрасится. */
	stage?: string
	/** Горы во всю ширину: стоят на нижнем краю страницы и поднимаются под контакты. */
	scenery?: boolean
}

const { stage = 'day', scenery = false } = Astro.props
const year = new Date().getFullYear()
---

<footer class="footer soft-rule" data-stage={stage}>
	{scenery && (
		<div class="footer__scenery" aria-hidden="true" data-scenery>
			<Picture
				class="footer__scenery-img"
				src={mountains}
				formats={['avif']}
				fallbackFormat="webp"
				alt=""
				widths={[768, 1280, 1920, 2400]}
				sizes="100vw"
			/>
		</div>
	)}
	<div class="container footer__inner muted">
		<span>
			© {year} {person.name}, {person.status}, ИНН {person.inn}
		</span>
		<span>{contacts.address}</span>
		<span>Информация на сайте не является медицинской консультацией</span>
	</div>
</footer>

<script>
	import { everyFrame, reduceMotion } from '#frontend/lib/frame.ts'

	const scenery = document.querySelector<HTMLImageElement>('[data-scenery] img')

	// Горы проявляются после загрузки. Из кэша картинка бывает готова раньше скрипта.
	const show = () => scenery?.closest('[data-scenery]')?.classList.add('footer__scenery--loaded')
	if (scenery?.complete && scenery.naturalWidth) show()
	else scenery?.addEventListener('load', show, { once: true })

	// Горы отстают от прокрутки, будто они далеко. Сдвиг считается от конца страницы,
	// а не от центра экрана: внизу он нулевой, и картинка ложится ровно на край.
	if (scenery && !reduceMotion)
		everyFrame(() => {
			const rest = document.documentElement.scrollHeight - scrollY - innerHeight
			const shift = Math.min(Math.max(rest, 0), innerHeight) * 0.2
			return () => (scenery.style.transform = `translate3d(0, ${shift.toFixed(1)}px, 0)`)
		})
</script>

<style>
	.footer {
		padding-block: 32px;
		font-size: 0.82rem;

		&__inner {
			position: relative;
			z-index: 1;
			display: flex;
			flex-wrap: wrap;
			gap: 8px 24px;
			justify-content: space-between;
		}

		/* Снизу обрезана краем страницы, контакты и подпись лежат поверх. Сдвинутая
		   параллаксом картинка не выходит за обёртку и не удлиняет страницу. */
		&__scenery {
			pointer-events: none;
			position: absolute;
			inset: auto 0 0;
			overflow: hidden;
			height: clamp(380px, 46vw, 680px);
			opacity: 0.7;
		}

		/* Тает в фон сама картинка, а не обёртка: иначе при сдвиге виден её верхний край. */
		& :global(.footer__scenery-img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 50% 30%;
			mask-image: linear-gradient(to bottom, transparent, #000 45%);
			transition: opacity 1.4s var(--ease);

			/* Проявляется, когда скрипт дождётся загрузки; без скриптов видна сразу. */
			@media (--scripting) {
				opacity: 0;
			}
		}

		&__scenery--loaded :global(.footer__scenery-img) {
			opacity: 1;
		}
	}
</style>
