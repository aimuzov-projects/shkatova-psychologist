---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Icon from '../../components/Icon.astro'
import Contacts from '../../components/Contacts.astro'
import Footer from '../../components/Footer.astro'
import { materials, type Material } from '../../data/materials'
import { contacts, person } from '../../data/site'

export const getStaticPaths = (() =>
	materials.map((material) => ({ params: { slug: material.slug }, props: { material } }))) satisfies GetStaticPaths

const { material } = Astro.props as { material: Material }
---

<Base title={`${material.title} — ${person.name}`} description={material.description}>
	<Header home={false} />
	<main class="material-page">
		<section class="section material-head" data-stage="night">
			<div class="container narrow">
				<a href="/#materials" class="back muted">
					<Icon name="arrow-up" size={16} class="back__icon" />
					Все материалы
				</a>
				<span class="eyebrow">{material.audience} · бесплатно</span>
				<h1>{material.title}</h1>
				<p class="lead selectable">{material.intro}</p>
				<button type="button" class="btn btn--ghost print-btn" data-print>
					<Icon name="download" size={18} />
					Сохранить в PDF
				</button>
			</div>
		</section>

		<section class="section material-body" data-stage="dusk">
			<div class="container narrow selectable">
				{material.blocks.map((block) => (
					<div class="block">
						<h2 class="block__title">{block.title}</h2>

						{block.type === 'phrases' && (
							<ol class="phrases">
								{block.items.map((item) => (
									<li class="phrase">
										<span class="phrase__label">{item.label}</span>
										<blockquote class="phrase__text">«{item.text}»</blockquote>
									</li>
								))}
							</ol>
						)}

						{block.type === 'replies' && (
							<ol class="replies soft-divide">
								{block.items.map((item) => (
									<li class="reply">
										<span class="reply__label muted">{item.label}</span>
										<blockquote class="reply__text">«{item.text}»</blockquote>
									</li>
								))}
							</ol>
						)}

						{block.type === 'formula' && (
							<>
								<p class="formula">{block.formula}</p>
								<p class="examples-title muted">{block.examplesTitle}</p>
								<ul class="examples">
									{block.examples.map((text) => (
										<li>«{text}»</li>
									))}
								</ul>
							</>
						)}

						{block.type === 'dont-do' && (
							<ol class="dont-do">
								<li class="dont-do__head" aria-hidden="true">
									<span>{block.dontLabel}</span>
									<span>{block.doLabel}</span>
								</li>
								{block.items.map((item, i) => (
									<li class="dont-do__row">
										<span class="dont-do__num">{String(i + 1).padStart(2, '0')}</span>
										<p class="dont-do__dont">
											<Icon name="cross" size={20} class="dont-do__mark" />
											<span class="visually-hidden">{block.dontLabel}: </span>
											{item.dont}
										</p>
										<p class="dont-do__do">
											<Icon name="check" size={20} class="dont-do__mark" />
											<span class="visually-hidden">{block.doLabel}: </span>
											{item.do}
										</p>
									</li>
								))}
							</ol>
						)}
					</div>
				))}
			</div>
		</section>

		<section class="section material-outro" data-stage="dawn">
			<div class="container narrow selectable">
				{material.outro.map((text) => (
					<p class="outro">{text}</p>
				))}
				<a href="#contacts" class="btn outro__cta">
					<Icon name="calendar" size={16} />
					Записаться на бесплатные 20 минут
				</a>
			</div>
		</section>

		<Contacts />

		<!-- Только для печати: на листе остаются автор и способ связаться. -->
		<p class="print-signature">
			{person.name}, {person.role.toLowerCase()} · Telegram {contacts.telegram.label} · {contacts.phone.label}
		</p>
	</main>
	<Footer />
</Base>

<script>
	document.querySelector('[data-print]')?.addEventListener('click', () => print())
</script>

<style>
	.narrow {
		max-width: calc(760px + var(--gutter) * 2);
	}

	.material-head {
		padding-top: calc(76px + var(--section-y));
	}

	.back {
		display: flex;
		width: fit-content;
		align-items: center;
		gap: 8px;
		margin-bottom: 32px;
		font-size: 0.88rem;
		text-decoration: none;
	}

	.back :global(.back__icon) {
		transform: rotate(-90deg);
	}

	.back:hover {
		color: var(--fg);
	}

	h1 {
		font-size: clamp(2.1rem, 5vw, 3.4rem);
	}

	.print-btn {
		margin-top: 12px;
		border: 0;
		font-family: inherit;
		cursor: pointer;
	}

	.block + .block {
		margin-top: 72px;
	}

	.block__title {
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		margin-bottom: 32px;
	}

	.phrases,
	.replies,
	.examples,
	.dont-do {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.phrase + .phrase {
		margin-top: 36px;
	}

	.phrase__label,
	.dont-do__head {
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
	}

	blockquote {
		margin: 0;
	}

	.phrase__text {
		margin-top: 10px;
		padding-left: 22px;
		border-left: 1px solid var(--accent);
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2.6vw, 1.65rem);
		line-height: 1.35;
	}

	.reply {
		padding-block: 22px;
	}

	.reply__label {
		font-size: 0.95rem;
	}

	.reply__text {
		margin-top: 6px;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.4;
	}

	.formula {
		padding: 22px 26px;
		border-radius: 16px;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2.6vw, 1.65rem);
		line-height: 1.35;
	}

	.examples-title {
		margin: 28px 0 12px;
		font-size: 0.95rem;
	}

	.examples li {
		font-size: 1.1rem;
	}

	.examples li + li {
		margin-top: 12px;
	}

	/* На телефоне пара "не надо / вместо этого" идёт стопкой, на десктопе -- в две колонки. */
	.dont-do__head {
		display: none;
	}

	.dont-do__row {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 10px 16px;
		padding-block: 24px;
		border-top: 1px solid var(--line);
	}

	.dont-do__num {
		grid-row: span 2;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		color: var(--accent);
	}

	.dont-do__dont,
	.dont-do__do {
		display: flex;
		gap: 10px;
		margin: 0;
	}

	.dont-do__dont {
		color: var(--muted);
	}

	.dont-do :global(.dont-do__mark) {
		flex-shrink: 0;
		margin-top: 0.2em;
	}

	.dont-do__dont :global(.dont-do__mark) {
		opacity: 0.7;
	}

	.dont-do__do :global(.dont-do__mark) {
		color: var(--accent);
	}

	@media (min-width: 768px) {
		.dont-do__head,
		.dont-do__row {
			display: grid;
			grid-template-columns: 40px 1fr 1.3fr;
			gap: 24px;
		}

		.dont-do__head {
			padding-bottom: 12px;
		}

		.dont-do__head span:first-child {
			grid-column: 2;
		}

		.dont-do__num {
			grid-row: auto;
		}
	}

	.outro {
		font-size: 1.2rem;
	}

	.outro:first-child {
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		line-height: 1.3;
	}

	.outro__cta {
		margin-top: 16px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.print-signature {
		display: none;
	}

	/* PDF через печать браузера: чёрным по белому, без шапки, кнопок и контактов. */
	@media print {
		:global(html),
		:global(body),
		:global([data-stage]) {
			--bg: #fff;
			--fg: #1d1d1d;
			--muted: #555;
			--accent: #8a5a4c;
			--line: #ddd;
			background: #fff !important;
			color: #1d1d1d;
		}

		:global(body::after),
		:global(.glow),
		:global(.header),
		:global(.fab),
		:global(#contacts),
		:global(.footer),
		.back,
		.print-btn,
		.outro__cta {
			display: none !important;
		}

		.section {
			padding-block: 0 24px;
		}

		.material-head {
			padding-top: 0;
		}

		.dont-do__row,
		.phrase,
		.reply {
			break-inside: avoid;
		}

		.print-signature {
			display: block;
			margin-top: 24px;
			padding-top: 12px;
			border-top: 1px solid #ddd;
			font-size: 0.85rem;
			color: #555;
		}
	}
</style>
