---
import { Image } from 'astro:assets';
import Blob from './Blob.astro';
import portrait from '../assets/portrait.webp';
import { person } from '../data/site';
---

<section class="hero" id="top">
  <Blob class="hero__blob hero__blob--a" color="var(--surface)" />
  <div class="container hero__inner">
    <div class="hero__text">
      <span class="eyebrow">{person.role}</span>
      <h1>{person.name}</h1>
      <p class="hero__tagline">{person.tagline}</p>
      <p class="lead">{person.intro}</p>
      <div class="hero__actions">
        <a href="#contacts" class="btn">Записаться на консультацию</a>
        <a href="#services" class="btn btn--ghost">Услуги и цены</a>
      </div>
      <p class="hero__note">{person.experience}</p>
    </div>

    <div class="hero__photo">
      <Blob class="hero__photo-bg" color="var(--rose)" variant={2} />
      <Image src={portrait} alt={person.name} widths={[420, 840]} sizes="(min-width: 900px) 420px, 100vw" loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 8vw, 104px);
  }

  .hero :global(.hero__blob--a) {
    position: absolute;
    width: 640px;
    top: -220px;
    left: -240px;
    opacity: 0.7;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
  }

  h1 {
    font-size: clamp(3rem, 9vw, 5.4rem);
    margin-bottom: 0.2em;
  }

  .hero__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    line-height: 1.3;
    color: var(--accent);
    max-width: 30ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block: 32px 20px;
  }

  .hero__note {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .hero__photo {
    position: relative;
    max-width: 420px;
    margin-inline: auto;
    width: 100%;
  }

  .hero__photo :global(.hero__photo-bg) {
    position: absolute;
    inset: -8% -10% auto auto;
    width: 105%;
  }

  .hero__photo img {
    position: relative;
    width: 100%;
    height: auto;
    border-radius: 200px 200px var(--radius) var(--radius);
    box-shadow: var(--shadow);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.2fr 1fr;
      gap: 64px;
    }
  }
</style>
