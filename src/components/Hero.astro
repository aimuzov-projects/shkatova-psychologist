---
import { Picture } from 'astro:assets'
import hero from '#/assets/hero.jpg'
import Icon from '#/components/Icon.astro'
import { person } from '#/data/site.ts'
---

<section class="hero" id="top" data-stage="night">
	<div class="hero__photo" aria-hidden="true">
		<div class="veil" data-veil />
		<div class="px" data-parallax="-0.2">
			{/* На десктопе фото скрыто, а eager-картинку браузер всё равно качает: 1px берёт самый маленький файл. */}
			<Picture
				formats={['avif']}
				fallbackFormat="webp"
				src={hero}
				alt=""
				widths={[480, 768, 960, 1280]}
				sizes="(min-width: 900px) 1px, 100vw"
				loading="eager"
				fetchpriority="high"
				class="hero__img"
			/>
		</div>
	</div>

	<div class="container story__text hero__inner">
		<div class="hero__text">
			<span class="eyebrow eyebrow--plain reveal reveal--in">{person.role} · Тольятти и онлайн</span>
			<h1 class="hero__title reveal reveal--in" data-delay="1">
				Вам говорят
				<br />
				«радуйся»
				<br />
				<em class="hero__accent">— а вам страшно</em>
			</h1>
			<p class="lead reveal reveal--in" data-delay="2">
				Работаю с тревогой в беременности, страхом родов, тяжёлыми первыми месяцами после — и с теми, кто
				потерял беременность. Первые 20 минут бесплатно: расскажете, что происходит, и вместе поймём, нужна ли
				я вам.
			</p>
			<div class="hero__actions reveal reveal--in" data-delay="3">
				<a href="#contacts" class="btn btn--breath">
					<Icon name="spark" size={18} />
					Бесплатные 20 минут знакомства
				</a>
				<a href="#services" class="btn btn--ghost">
					<Icon name="sunrise" size={18} />
					Услуги
				</a>
			</div>
		</div>
	</div>

	<a href="#about" class="hero__hint" aria-label="К следующему разделу">
		<span class="mouse">
			<span class="mouse__wheel" />
		</span>
	</a>
</section>

<script>
	import '#/lib/section-photo.ts'
</script>

<style>
	.hero {
		position: relative;
		overflow: clip;
		display: grid;
		align-items: end;
		min-height: 100svh;
		padding-block: 0 96px;

		@media (--md) {
			align-items: center;
			padding-block: 120px 96px;
		}

		&__inner {
			position: relative;
			z-index: 2;
		}

		&__text {
			max-width: 620px;
		}

		/* Строки склеены неразрывными пробелами: на телефоне шрифт идёт от ширины экрана. */
		&__title {
			font-size: clamp(1.7rem, 8.6vw, 4.4rem);

			/* На десктопе колонке текста достаётся чуть больше половины экрана: при 5vw строка
			   "— а вам страшно" к 1440px становилась шире колонки и уходила под фото. */
			@media (--md) {
				font-size: clamp(2.2rem, 4.2vw, 4rem);
			}
		}

		&__accent {
			font-style: normal;
			color: var(--accent);
			transition: color 1.4s var(--ease);
		}

		/* На телефоне кнопки друг под другом во всю ширину; от 360px текст в одну строку. */
		&__actions {
			display: grid;
			gap: 10px;
			margin-top: 32px;

			@media (min-width: 560px) {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 36px;
			}
		}

		&__actions .btn {
			justify-content: center;
			padding-inline: 1.2em;
			text-align: center;

			@media (min-width: 360px) {
				white-space: nowrap;
			}

			@media (min-width: 560px) {
				padding-inline: 1.9em;
			}
		}

		/* Фото уходит в ночь по левому краю и снизу, чтобы не спорить с текстом. */
		&__photo {
			position: relative;
			z-index: 0;
			overflow: hidden;
			height: min(54svh, 480px);
			margin-bottom: -6svh;
			-webkit-mask-image: linear-gradient(to top, transparent 0%, #000 45%);
			mask-image: linear-gradient(to top, transparent 0%, #000 45%);

			@media (--md) {
				display: none;
			}
		}

		&__photo::before {
			content: '';
			position: absolute;
			z-index: 1;
			inset: 0;
			background: linear-gradient(to bottom, var(--bg) 0%, transparent 32%);
			transition: background 1.4s var(--ease);
		}

		/* Первый экран при прокрутке только отстаёт и едет вниз, запас нужен сверху. Больше
		   не даём, иначе обрезается голова, а щель в самом конце пути прячет градиент сверху. */
		&__photo .px {
			position: absolute;
			inset: -18% 0 -6%;
		}

		& :global(.hero__img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 50% 0%;
		}

		/* Мышка по центру низа экрана, прячется после первого скролла. */
		&__hint {
			position: fixed;
			z-index: 15;
			bottom: 28px;
			left: 50%;
			transform: translateX(-50%);
			color: var(--muted);
			transition:
				opacity 0.6s var(--ease),
				color 1.4s var(--ease);

			/* На сенсорных экранах мышки нет, а подсказка налезает на кнопку. */
			@media (pointer: coarse), (--below-md) {
				display: none;
			}

			:global(.page--scrolled) & {
				pointer-events: none;
				opacity: 0;
			}
		}
	}

	.btn {
		/* Кнопка светится и дышит: 4 секунды ярче, 4 секунды тише. Дышит слой с готовой
		   тенью через opacity -- анимацию box-shadow браузер перерисовывал бы на каждом кадре. */
		&--breath {
			position: relative;
			box-shadow: 0 0 14px 0 color-mix(in srgb, var(--accent) 35%, transparent);
		}

		&--breath::after {
			pointer-events: none;
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
			opacity: 0;
			box-shadow: 0 0 44px 10px color-mix(in srgb, var(--accent) 70%, transparent);
			animation: glow 8s ease-in-out infinite;
		}
	}

	.mouse {
		display: block;
		width: 24px;
		height: 38px;
		border: 1.5px solid currentColor;
		border-radius: 12px;

		&__wheel {
			display: block;
			width: 3px;
			height: 7px;
			margin: 6px auto 0;
			border-radius: 2px;
			background: currentColor;
			animation: wheel 2s ease-in-out infinite;
		}
	}

	@keyframes wheel {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		70% {
			transform: translateY(12px);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 0;
		}
	}

	@keyframes glow {
		50% {
			opacity: 1;
		}
	}
</style>
