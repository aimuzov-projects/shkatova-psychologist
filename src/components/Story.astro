---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// Фото справа от нескольких секций. Без trigger видно сразу, остальные включаются,
// когда trigger выше линии at (до 1 -- доля экрана, больше -- пиксели от верха).
// На телефоне колонка скрыта, но eager-фото всё равно качается: sizes 1px берёт самый лёгкий файл.
type Shot = {
	src: ImageMetadata
	/** Селектор элемента, который включает кадр. Без него кадр виден сразу. */
	trigger?: string
	/** Линия для `trigger`: до 1 -- доля экрана, больше -- пиксели от верха. По умолчанию 0. */
	at?: number
}

type Props = {
	/** Кадры по порядку прокрутки: активен последний, чей `trigger` уже прошёл свою линию. */
	shots: Shot[]
	/** Сколько строк сетки (секций из slot) занимает колонка с фото, по умолчанию 2. */
	rows?: number
	/** Грузить первый кадр сразу и с высоким приоритетом, для фото на первом экране. */
	eager?: boolean
}

const { shots, rows = 2, eager = false } = Astro.props
---

<div class="story">
	<div class="story__photos" style={`grid-row: 1 / span ${rows}`} aria-hidden="true">
		<div class="story__sticky">
			{shots.map((shot, i) => (
				<Picture
					class="story__shot"
					data-trigger={shot.trigger}
					data-at={shot.at}
					src={shot.src}
					formats={['avif']}
					fallbackFormat="webp"
					alt=""
					widths={[480, 640, 1280]}
					sizes="(min-width: 900px) 46vw, 1px"
					loading={eager && i === 0 ? 'eager' : 'lazy'}
					fetchpriority={eager && i === 0 ? 'high' : 'auto'}
				/>
			))}
			<div class="veil" data-veil="story" />
		</div>
	</div>
	<slot />
</div>

<script>
	import { everyFrame, type Write } from '#/lib/frame.ts'

	// Активно последнее фото, чья линия пройдена; вуаль густеет до следующего.
	const stories = [...document.querySelectorAll<HTMLElement>('.story')].map((story) => ({
		story,
		veil: story.querySelector<HTMLElement>('[data-veil="story"]'),
		shots: [...story.querySelectorAll<HTMLElement>('.story__shot')].map((el) => ({
			el,
			trigger: el.dataset.trigger ? document.querySelector<HTMLElement>(el.dataset.trigger) : null,
			at: Number(el.dataset.at ?? 0),
		})),
	}))

	everyFrame((): Write => {
		const vh = innerHeight
		const writes = stories.map(({ story, veil, shots }): Write => {
			const box = story.getBoundingClientRect()
			const passed = shots.map(({ trigger, at }) =>
				trigger ? (at <= 1 ? vh * at : at) - trigger.getBoundingClientRect().top : -box.top,
			)
			let active = -1
			passed.forEach((p, i) => p >= 0 && (active = i))
			let opacity: string | null = null
			if (veil && active >= 0) {
				const end =
					active + 1 < passed.length ? passed[active] - passed[active + 1] : passed[active] + box.bottom - vh
				const progress = Math.min(1, Math.max(0, passed[active] / Math.max(1, end)))
				opacity = (0.35 + 0.45 * progress).toFixed(3)
			}
			return () => {
				shots.forEach(({ el }, i) => el.classList.toggle('story__shot--active', i === active))
				if (veil && opacity) veil.style.opacity = opacity
			}
		})
		return () => writes.forEach((write) => write())
	})
</script>

<style>
	.story {
		@media (--md) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 46vw;
		}
		/* На телефоне колонки нет: секции показывают свои фото сами. */
		&__photos {
			display: none;

			@media (--md) {
				display: block;
				grid-column: 2;
			}
		}

		/* stylelint-disable-next-line selector-max-type -- секции приходят через slot, общего класса у них нет */
		& > :global(section) {
			@media (--md) {
				grid-column: 1;
			}
		}

		&__sticky {
			@media (--md) {
				position: sticky;
				top: 0;
				overflow: hidden;
				height: 100svh;
				-webkit-mask-image:
					linear-gradient(to right, transparent 0%, #000 30%),
					linear-gradient(to top, transparent 0%, #000 28%);
				mask-image:
					linear-gradient(to right, transparent 0%, #000 30%),
					linear-gradient(to top, transparent 0%, #000 28%);
				-webkit-mask-composite: source-in;
				mask-composite: intersect;
			}
		}

		&__sticky :global(.story__shot) {
			@media (--md) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				object-fit: cover;
				object-position: 55% 30%;
				transition: opacity 1.4s var(--ease);
			}
		}

		&__sticky :global(.story__shot--active) {
			@media (--md) {
				opacity: 1;
			}
		}

		/* Без скриптов кадры не переключаются: остаётся первый, он и так виден сразу. */
		&__sticky :global(.story__shot:not([data-trigger])) {
			@media (--md) and (--no-scripting) {
				opacity: 1;
			}
		}
	}
</style>
