---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// Фото справа от нескольких секций. Без trigger видно сразу, остальные включаются,
// когда trigger выше линии at (до 1 -- доля экрана, больше -- пиксели от верха).
// На телефоне колонка скрыта, но eager-фото всё равно качается: sizes 1px берёт самый лёгкий файл.
type Shot = {
	src: ImageMetadata
	/** Селектор элемента, который включает кадр. Без него кадр виден сразу. */
	trigger?: string
	/** Линия для `trigger`: до 1 -- доля экрана, больше -- пиксели от верха. По умолчанию 0. */
	at?: number
}

type Props = {
	/** Кадры по порядку прокрутки: активен последний, чей `trigger` уже прошёл свою линию. */
	shots: Shot[]
	/** Сколько строк сетки (секций из slot) занимает колонка с фото, по умолчанию 2. */
	rows?: number
	/** Грузить первый кадр сразу и с высоким приоритетом, для фото на первом экране. */
	eager?: boolean
}

const { shots, rows = 2, eager = false } = Astro.props
---

<div class="story">
	<div class="story__photos" style={`grid-row: 1 / span ${rows}`} aria-hidden="true">
		<div class="story__sticky">
			{shots.map((shot, i) => (
				<Picture
					class="story__shot"
					data-trigger={shot.trigger}
					data-at={shot.at}
					src={shot.src}
					formats={['avif']}
					fallbackFormat="webp"
					alt=""
					widths={[480, 640, 1280]}
					sizes="(min-width: 900px) 46vw, 1px"
					loading={eager && i === 0 ? 'eager' : 'lazy'}
					fetchpriority={eager && i === 0 ? 'high' : 'auto'}
				/>
			))}
			<div class="veil" data-veil="story"></div>
		</div>
	</div>
	<slot />
</div>

<style>
	.story {
		@media (--md) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 46vw;
		}
		/* На телефоне колонки нет: секции показывают свои фото сами. */
		&__photos {
			display: none;

			@media (--md) {
				display: block;
				grid-column: 2;
			}
		}

		/* stylelint-disable-next-line selector-max-type -- секции приходят через slot, общего класса у них нет */
		& > :global(section) {
			@media (--md) {
				grid-column: 1;
			}
		}

		&__sticky {
			@media (--md) {
				position: sticky;
				top: 0;
				overflow: hidden;
				height: 100svh;
				-webkit-mask-image:
					linear-gradient(to right, transparent 0%, #000 30%),
					linear-gradient(to top, transparent 0%, #000 28%);
				mask-image:
					linear-gradient(to right, transparent 0%, #000 30%),
					linear-gradient(to top, transparent 0%, #000 28%);
				-webkit-mask-composite: source-in;
				mask-composite: intersect;
			}
		}

		&__sticky :global(.story__shot) {
			@media (--md) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				object-fit: cover;
				object-position: 55% 30%;
				transition: opacity 1.4s var(--ease);
			}
		}

		&__sticky :global(.story__shot--active) {
			@media (--md) {
				opacity: 1;
			}
		}
	}
</style>
