---
import { Picture } from 'astro:assets'

import mountains from '#/assets/mountains.jpg'
import { person } from '#/data/site.ts'

type Props = {
	/** `data-stage` футера, по умолчанию `day`. Вне главной -- как у страницы, иначе фон перекрасится. */
	stage?: string
	/** Горы во всю ширину: стоят на нижнем краю страницы и поднимаются под контакты. */
	scenery?: boolean
}

const { stage = 'day', scenery = false } = Astro.props
const year = new Date().getFullYear()
---

<footer class="footer soft-rule" data-stage={stage}>
	{scenery && (
		<div class="footer__scenery" aria-hidden="true" data-scenery>
			<Picture
				class="footer__scenery-img"
				src={mountains}
				formats={['avif']}
				fallbackFormat="webp"
				alt=""
				widths={[768, 1280, 1920, 2400]}
				sizes="100vw"
			/>
		</div>
	)}
	<div class="container footer__inner muted">
		<span>
			© {year} {person.name}, {person.status}, ИНН {person.inn}
		</span>
		<span>Информация на сайте не является медицинской консультацией</span>
	</div>
</footer>

<script>
	import { everyFrame, reduceMotion } from '#/lib/frame.ts'

	// Горы отстают от прокрутки, будто они далеко. Сдвиг считается от конца страницы,
	// а не от центра экрана: внизу он нулевой, и картинка ложится ровно на край.
	const scenery = document.querySelector<HTMLElement>('[data-scenery] img')
	if (scenery && !reduceMotion)
		everyFrame(() => {
			const rest = document.documentElement.scrollHeight - scrollY - innerHeight
			const shift = Math.min(Math.max(rest, 0), innerHeight) * 0.2
			return () => (scenery.style.transform = `translate3d(0, ${shift.toFixed(1)}px, 0)`)
		})
</script>

<style>
	.footer {
		padding-block: 32px;
		font-size: 0.82rem;

		&__inner {
			position: relative;
			z-index: 1;
			display: flex;
			flex-wrap: wrap;
			gap: 8px 24px;
			justify-content: space-between;
		}

		/* Сверху тает в фон, снизу обрезана краем страницы. Контакты и подпись лежат поверх.
		   Сдвинутая параллаксом картинка не выходит за обёртку и не удлиняет страницу. */
		&__scenery {
			pointer-events: none;
			position: absolute;
			inset: auto 0 0;
			overflow: hidden;
			height: clamp(380px, 46vw, 680px);
			opacity: 0.7;
			mask-image: linear-gradient(to bottom, transparent, #000 45%);
		}

		& :global(.footer__scenery-img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 50% 30%;
		}
	}
</style>
