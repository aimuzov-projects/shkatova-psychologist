---
import { person } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <span>© {year} {person.name}</span>
    <span>Информация на сайте не является медицинской консультацией</span>
  </div>
</footer>

<style>
  .footer {
    padding-block: 32px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
</style>
