---
// Знак: раскрытая дуга-объятие и точка внутри, мама и малыш. Рисуется currentColor.
type Props = {
	size?: number
	class?: string
}

const { size = 40, class: className } = Astro.props
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 40 40"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	aria-hidden="true"
>
	<path d="M12 9.5A14 14 0 1 0 28 9.5" />
	<path d="M15.5 17.5c2.5 4.5 6.5 4.5 9 0" />
	<circle cx="20" cy="12" r="3" fill="currentColor" stroke="none" />
</svg>
