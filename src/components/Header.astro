---
import Icon from '@/components/Icon.astro'
import Logo from '@/components/Logo.astro'
import { nav, person } from '@/data/site'

type Props = {
	/** `false` вне главной: якоря шапки ведут на `/#...`. */
	home?: boolean
}

const { home = true } = Astro.props
const base = home ? '' : '/'
---

<header class="header">
	<div class="container header__inner">
		<a href={`${base}#top`} class="logo">
			<Logo class="logo__mark" size={40} />
			<span class="logo__text">
				<span class="logo__name">{person.name}</span>
				<span class="logo__role">{person.role}</span>
			</span>
		</a>
		<nav aria-label="Основное меню">
			<ul class="nav">
				{nav.map((item) => (
					<li>
						<a href={base + item.href} class="nav__link">
							<Icon name={item.icon} size={16} class="nav__icon" />
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<a href={`${base}#contacts`} class="btn header__cta">
			<Icon name="calendar" size={16} />
			Записаться
		</a>
	</div>
</header>

<a href="#contacts" class="fab" aria-label="Записаться">
	<span class="fab__bg"></span>
	<span class="fab__icons">
		<Icon name="calendar" size={24} class="fab__icon fab__icon--book" />
		<Icon name="arrow-up" size={24} class="fab__icon fab__icon--up" />
	</span>
</a>

<style>
	.header {
		position: fixed;
		z-index: 20;
		inset: 0 0 auto;
		color: var(--fg);
		/* Подложка с размытием всегда, а не только после прокрутки: меню читается над фото. */
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(14px);
		box-shadow: 0 8px 24px -18px rgb(20 10 20 / 0.18);
		transition:
			color 1.4s var(--ease),
			background-color 1.4s var(--ease),
			transform 1s cubic-bezier(0.65, 0, 0.35, 1);

		/* Телефон: за первым экраном шапка уезжает вместе со своей кнопкой,
		   а запись живёт в круглой кнопке, которая выезжает справа в угол. */
		:global(.page--past-hero) & {
			@media (--below-lg) {
				transform: translateY(-100%);
			}
		}

		&::after {
			content: '';
			position: absolute;
			inset: auto 0 0;
			height: 1px;
			opacity: 0.6;
			background: linear-gradient(to right, transparent, var(--line) 25%, var(--line) 75%, transparent);
		}

		&__inner {
			display: flex;
			gap: 24px;
			align-items: center;
			justify-content: space-between;
			min-height: 76px;
		}

		&__cta {
			padding: 0.7em 1.4em;
			font-size: 0.85rem;
		}
	}

	.fab {
		pointer-events: none;
		position: fixed;
		z-index: 30;
		right: 16px;
		bottom: calc(16px + env(safe-area-inset-bottom));
		transform: translateX(calc(100% + 16px + env(safe-area-inset-right)));
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		color: var(--btn-fg);
		visibility: hidden;
		transition:
			transform 0.6s var(--ease),
			visibility 0s 0.6s;

		@media (--reduced-motion) {
			transition: none;
		}

		@media (--lg) {
			display: none;
		}

		&__bg {
			position: absolute;
			inset: 0;
			border-radius: 999px;
			background: var(--btn-bg);
			box-shadow: 0 10px 30px -12px rgb(20 10 20 / 0.45);
		}

		&__icons {
			position: relative;
			display: grid;
		}

		/* У контактов записываться уже некуда: календарь уступает место стрелке наверх. */
		& :global(.fab__icon) {
			grid-area: 1 / 1;
			transition:
				opacity 0.3s var(--ease),
				transform 0.45s var(--ease);
		}

		& :global(.fab__icon--up),
		:global(.page--at-contacts) & :global(.fab__icon--book) {
			transform: rotate(-90deg) scale(0.6);
			opacity: 0;
		}

		:global(.page--at-contacts) & :global(.fab__icon--up) {
			transform: none;
			opacity: 1;
		}

		:global(.page--past-hero) & {
			pointer-events: auto;
			transform: none;
			visibility: visible;
			transition: transform 0.6s var(--ease);

			@media (--reduced-motion) {
				transition: none;
			}
		}
	}

	.logo {
		display: flex;
		gap: 12px;
		align-items: center;
		line-height: 1.15;
		text-decoration: none;

		& :global(.logo__mark) {
			flex-shrink: 0;
			color: var(--accent);
			transition:
				color 1.4s var(--ease),
				transform 0.6s var(--ease);
		}

		&:hover :global(.logo__mark) {
			transform: rotate(-8deg);
		}

		&__text {
			display: flex;
			flex-direction: column;
		}

		&__name {
			font-family: var(--font-serif);
			font-size: 1.25rem;
		}

		&__role {
			display: none;
			font-size: 0.66rem;
			color: var(--muted);
			text-transform: uppercase;
			letter-spacing: 0.18em;
			transition: color 1.4s var(--ease);

			@media (--sm) {
				display: block;
			}

			/* Шесть пунктов меню с иконками и подписью под именем влезают только от 1280px. */
			@media (--lg) and (--below-xl) {
				display: none;
			}
		}
	}

	.nav {
		display: none;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;

		@media (--lg) {
			display: flex;
		}

		&__link {
			display: inline-flex;
			gap: 7px;
			align-items: center;
			font-size: 0.9rem;
			text-decoration: none;
			white-space: nowrap;
			opacity: 0.8;
			transition: opacity 0.3s;
		}

		& :global(.nav__icon) {
			color: var(--accent);
			transition: color 1.4s var(--ease);

			/* Шесть пунктов меню с иконками и подписью под именем влезают только от 1280px. */
			@media (--lg) and (--below-xl) {
				display: none;
			}
		}

		&__link:hover {
			opacity: 1;
		}
	}
</style>
