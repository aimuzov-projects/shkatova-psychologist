---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// Фото над текстом секции на телефоне: уходит в фон снизу, сверху тонет в шапке.
// На десктопе прячется, там фото показывает колонка Story.
type Props = {
	src: ImageMetadata
	position?: string
}

const { src, position = '50% 0%' } = Astro.props
---

<div class="section-photo" aria-hidden="true">
	<div class="veil" data-veil></div>
	<div class="px" data-parallax="-0.2">
		<Picture
			class="section-photo__img"
			formats={['avif']}
			fallbackFormat="webp"
			src={src}
			alt=""
			widths={[480, 768, 960, 1280]}
			sizes="100vw"
			style={`object-position: ${position}`}
		/>
	</div>
</div>

<style>
	/* Фото тает и сверху, и снизу: сквозь края виден настоящий фон страницы, шва нет. */
	.section-photo {
		position: relative;
		z-index: 0;
		overflow: hidden;
		height: min(54svh, 480px);
		margin-bottom: -6svh;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 28%, #000 55%, transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0%, #000 28%, #000 55%, transparent 100%);

		@media (--md) {
			display: none;
		}

		& :global(.section-photo__img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}

	/* Запас под сдвиг параллакса только снизу: лица на фото у верхнего края, запас сверху
	   их срезал бы. Щель сверху, пока фото уезжает, попадает в растворённый маской край. */
	.px {
		position: absolute;
		inset: 0 0 -30%;
	}
</style>
