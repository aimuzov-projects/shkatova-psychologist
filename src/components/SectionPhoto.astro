---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Фото над текстом секции на телефоне: уходит в фон снизу, сверху тонет в шапке.
// На десктопе прячется, там фото показывает колонка Story.
interface Props {
  src: ImageMetadata;
  position?: string;
}

const { src, position = '50% 0%' } = Astro.props;
---

<div class="section-photo" aria-hidden="true">
  <div class="veil" data-veil></div>
  <div class="px" data-parallax="-0.08">
    <Image src={src} alt="" widths={[640, 1280]} sizes="100vw" style={`object-position: ${position}`} />
  </div>
</div>

<style>
  .section-photo {
    position: relative;
    z-index: 0;
    height: min(70svh, 640px);
    margin-bottom: -6svh;
    overflow: hidden;
    mask-image: linear-gradient(to top, transparent 0%, #000 45%);
    -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 45%);
  }

  .section-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, var(--page-bg, var(--bg)) 0%, transparent 30%);
  }

  .px {
    height: 112%;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .section-photo {
      display: none;
    }
  }
</style>
