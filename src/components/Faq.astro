---
import { faq } from '../data/site';
---

<section class="section section--tinted" id="faq">
  <div class="container faq">
    <div>
      <span class="eyebrow">Вопросы</span>
      <h2>Частые вопросы</h2>
      <p class="lead">Не нашли ответа? Напишите мне — отвечу лично.</p>
    </div>

    <div class="faq__list">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 40px;
  }

  details {
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    margin-bottom: 12px;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent);
    font-size: 1.3rem;
    font-weight: 400;
    transition: transform 0.25s;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .faq {
      grid-template-columns: 1fr 1.5fr;
      gap: 72px;
    }
  }
</style>
