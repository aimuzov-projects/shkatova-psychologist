---
import Icon from './Icon.astro'
import { faq } from '../data/site'
---

<section class="section" id="faq" data-stage="morning">
	<div class="container story__text">
		<span class="eyebrow reveal">Вопросы</span>
		<h2 class="reveal" data-delay="1">
			Что обычно спрашивают
		</h2>
		<p class="lead reveal" data-delay="2">
			Не нашли ответа? Напишите мне — отвечу лично.
		</p>

		<div class="faq soft-divide">
			{faq.map((item) => (
				<div class="faq__item reveal">
					<span class="faq__badge" aria-hidden="true">
						<Icon name={item.icon} class="faq__icon" size={30} />
					</span>
					<div class="faq__body">
						<h3 class="faq__q">{item.q}</h3>
						<p class="faq__a muted">{item.a}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.faq {
		margin: 40px 0 0;

		/* На телефоне иконка в строку с вопросом и ростом с него, ответ под ними. */
		&__item {
			position: relative;
			display: grid;
			grid-template-columns: auto 1fr;
			gap: 8px 12px;
			align-items: start;
			padding-block: 22px;

			@media (--md) {
				grid-template-columns: 64px 1fr;
				gap: 20px;
				align-items: start;
				padding-block: 26px;
			}
		}

		&__body {
			display: contents;

			@media (--md) {
				display: block;
			}
		}

		&__badge {
			display: grid;
			place-items: center;
			color: var(--accent);
			transition:
				color 1.4s var(--ease),
				background-color 1.4s var(--ease),
				transform 0.6s var(--ease);

			@media (--md) {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				background: color-mix(in srgb, var(--accent) 10%, transparent);
			}
		}

		& :global(.faq__icon) {
			width: 1.6rem;
			height: 1.6rem;

			@media (--md) {
				width: 30px;
				height: 30px;
			}
		}

		&__item:hover .faq__badge {
			transform: scale(1.06) rotate(-4deg);
		}

		&__q {
			margin: 0;
			font-size: 1.3rem;
			line-height: 1.25;
			letter-spacing: normal;

			@media (--md) {
				margin: 6px 0 8px;
			}
		}

		&__a {
			grid-column: 1 / -1;
			max-width: 52ch;
			margin: 0;
			font-size: 0.97rem;

			@media (--md) {
				grid-column: auto;
			}
		}
	}
</style>
