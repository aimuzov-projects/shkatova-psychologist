---
import Icon from './Icon.astro';
import SectionPhoto from './SectionPhoto.astro';
import { services } from '../data/site';
import photo from '../assets/services.jpg';
---

<section class="section services-section" id="services" data-stage="rose">
  <SectionPhoto src={photo} position="50% 15%" />

  <div class="container story__text">
    <span class="eyebrow reveal">Услуги и цены</span>
    <h2 class="reveal" data-delay="1">Форматы работы</h2>
    <p class="lead reveal" data-delay="2">
      Первую встречу можно провести в любом формате — после неё решим, что подходит именно вам.
    </p>

    <div class="services">
      <ol class="services__list soft-divide">
        {services.map((s, i) => (
          <li class="service reveal" data-delay={String(i % 3)}>
            <a href="#contacts" class="service__link">
              <span class="service__icon"><Icon name={s.icon} size={28} /></span>
              <span class="service__body">
                <span class="service__title">
                  {s.title}
                  {s.featured && <span class="service__badge">бесплатно</span>}
                </span>
                <span class="service__text muted">{s.text}</span>
              </span>
              <span class="service__meta">
                <span class="service__price">{s.price}</span>
                <span class="service__duration muted">{s.duration}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .services-section {
    overflow: clip;
    padding-top: 0;
  }

  .services {
    margin-top: 48px;
  }

  .story__text {
    position: relative;
    z-index: 2;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service__link {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 8px 16px;
    padding: 26px 12px;
    margin-inline: -12px;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 0.4s var(--ease);
  }

  .service__link:hover,
  .service__link:focus-visible {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .service__icon {
    color: var(--accent);
    padding-top: 0.2em;
    transition: color 1.4s var(--ease);
  }

  .service__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .service__badge {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    transition: background-color 1.4s var(--ease), color 1.4s var(--ease);
  }

  .service__text {
    display: block;
    margin-top: 8px;
    font-size: 0.93rem;
    max-width: 44ch;
  }

  .service__meta {
    grid-column: 2;
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .service__price {
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }

  .service__duration {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .services-section {
      padding-top: var(--section-y);
    }

    .service__link {
      grid-template-columns: 52px 1fr auto;
    }

    .service__meta {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      text-align: right;
    }
  }
</style>
