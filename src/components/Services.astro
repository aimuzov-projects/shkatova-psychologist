---
import Icon from './Icon.astro'
import SectionPhoto from './SectionPhoto.astro'
import { services } from '../data/site'
import photo from '../assets/services.jpg'

const offer = services.find((s) => s.popular)
const rest = services.filter((s) => !s.popular)
---

<section class="section services-section" id="services" data-stage="rose">
	<SectionPhoto src={photo} position="50% 15%" />

	<div class="container story__text">
		<span class="eyebrow reveal">Услуги и цены</span>
		<h2 class="reveal" data-delay="1">
			Форматы работы
		</h2>
		<p class="lead reveal" data-delay="2">
			Первую встречу можно провести в любом формате — после неё решим, что подходит именно вам.
		</p>

		<div class="services">
			{offer && (
				<a href="#contacts" class="offer reveal">
					<span class="offer__badge">
						<Icon name="heart" size={16} />
						Чаще всего выбирают
					</span>
					<span class="offer__head">
						<span class="offer__title">{offer.title}</span>
						<span class="offer__prices">
							{offer.oldPrice && (
								<del class="offer__old">
									<span class="visually-hidden">Было </span>
									{offer.oldPrice}
								</del>
							)}
							<span class="offer__price">
								{offer.oldPrice && <span class="visually-hidden">Сейчас </span>}
								{offer.price}
							</span>
						</span>
					</span>
					<span class="offer__duration">{offer.duration}</span>
					<span class="offer__text">{offer.text}</span>
					<span class="offer__cta">
						Записаться
						<Icon name="arrow-out" size={18} />
					</span>
				</a>
			)}

			<ol class="services__list soft-divide">
				{rest.map((s, i) => (
					<li class="service reveal" data-delay={String(i % 3)}>
						<a href="#contacts" class="service__link">
							<span class="service__icon">
								<Icon name={s.icon} size={28} />
							</span>
							<span class="service__body">
								<span class="service__title">{s.title}</span>
								<span class="service__text muted">{s.text}</span>
							</span>
							<span class="service__meta">
								{s.oldPrice && <del class="service__old muted">{s.oldPrice}</del>}
								<span class:list={['service__price', s.free && 'service__price--free']}>{s.price}</span>
								<span class="service__duration muted">{s.duration}</span>
							</span>
						</a>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.services-section {
		overflow: clip;
		padding-top: 0;
	}

	.services {
		margin-top: 48px;
	}

	/* Самую покупаемую услугу видно сразу, как "популярный тариф": не строка списка, а
	   стеклянная карточка, как шапка. Сквозь размытие просвечивает фон страницы, сверху
	   тёплый блик, а свет вокруг дышит в такт главной кнопке первого экрана. */
	.offer {
		position: relative;
		display: grid;
		gap: 10px;
		margin-bottom: 24px;
		padding: 26px 24px 24px;
		border-radius: 24px;
		background:
			radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--accent) 26%, transparent), transparent 60%),
			linear-gradient(160deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.04));
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.22),
			inset 0 1px 0 rgb(255 255 255 / 0.35),
			0 24px 50px -28px rgb(20 10 20 / 0.55);
		color: var(--fg);
		text-decoration: none;
		transition: transform 0.5s var(--ease);
	}

	.offer::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		box-shadow: 0 0 46px 4px color-mix(in srgb, var(--accent) 35%, transparent);
		opacity: 0;
		pointer-events: none;
		animation: offer-glow 8s ease-in-out infinite;
	}

	@keyframes offer-glow {
		50% {
			opacity: 1;
		}
	}

	.offer:hover,
	.offer:focus-visible {
		transform: translateY(-3px);
	}

	.offer__badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: fit-content;
		padding: 6px 12px;
		border-radius: 999px;
		background: var(--btn-bg);
		color: var(--btn-fg);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.offer__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 4px 16px;
		margin-top: 6px;
	}

	.offer__title,
	.offer__price {
		font-family: var(--font-serif);
		line-height: 1.1;
	}

	.offer__title {
		font-size: clamp(1.7rem, 4vw, 2.2rem);
	}

	.offer__prices {
		display: inline-flex;
		align-items: baseline;
		gap: 10px;
	}

	.offer__price {
		font-size: clamp(1.5rem, 3.4vw, 1.9rem);
		color: var(--accent);
	}

	.offer__old,
	.service__old {
		font-family: var(--font-serif);
		text-decoration-thickness: 1.5px;
	}

	.offer__old {
		font-size: 1.1rem;
		opacity: 0.55;
	}

	.service__old {
		font-size: 1rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.offer__duration {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.offer__text {
		max-width: 52ch;
		font-size: 0.97rem;
		opacity: 0.85;
	}

	.offer__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: 8px;
		padding: 0.9em 1.6em;
		border-radius: 999px;
		background: var(--btn-bg);
		color: var(--btn-fg);
		font-weight: 500;
		font-size: 0.95rem;
		transition: background-color 0.6s var(--ease);
	}

	.offer:hover .offer__cta {
		background: var(--btn-hover);
	}

	.offer__cta :global(svg) {
		transition: transform 0.5s var(--ease);
	}

	.offer:hover .offer__cta :global(svg) {
		transform: translate(3px, -3px);
	}

	@media (min-width: 600px) {
		.offer {
			padding: 32px 36px 30px;
		}

		.offer__cta {
			width: fit-content;
		}
	}

	.story__text {
		position: relative;
		z-index: 2;
	}

	.services__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* На телефоне иконка в строку с названием, описание и цена под ними. */
	.service__link {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: 8px 12px;
		padding: 26px 12px;
		margin-inline: -12px;
		border-radius: 12px;
		text-decoration: none;
		transition: background-color 0.4s var(--ease);
	}

	.service__link:hover,
	.service__link:focus-visible {
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.service__icon {
		display: grid;
		color: var(--accent);
		transition: color 1.4s var(--ease);
	}

	.service__icon :global(svg) {
		width: 1.6rem;
		height: 1.6rem;
	}

	.service__body {
		display: contents;
	}

	.service__title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		line-height: 1.15;
	}

	.service__text {
		grid-column: 1 / -1;
		display: block;
		font-size: 0.93rem;
		max-width: 44ch;
	}

	.service__meta {
		grid-column: 1 / -1;
		display: flex;
		align-items: baseline;
		gap: 14px;
	}

	.service__price {
		font-family: var(--font-serif);
		font-size: 1.35rem;
	}

	/* «Бесплатно» -- не цена, а повод написать: плашка заметнее цифр. */
	.service__price--free {
		padding: 0.15em 0.7em 0.2em;
		border-radius: 999px;
		background: var(--btn-bg);
		color: var(--btn-fg);
		font-size: 1.1rem;
		box-shadow: 0 0 16px 0 color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.service__duration {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (min-width: 900px) {
		.services-section {
			padding-top: var(--section-y);
		}

		.service__link {
			grid-template-columns: 52px 1fr auto;
			align-items: start;
			gap: 8px 16px;
		}

		.service__icon {
			padding-top: 0.2em;
		}

		.service__icon :global(svg) {
			width: 28px;
			height: 28px;
		}

		.service__body {
			display: block;
		}

		.service__text {
			grid-column: auto;
			margin-top: 8px;
		}

		.service__meta {
			grid-column: 3;
			flex-direction: column;
			align-items: flex-end;
			gap: 4px;
			text-align: right;
		}
	}
</style>
