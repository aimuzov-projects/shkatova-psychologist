---
import Icon from './Icon.astro'
import SectionPhoto from './SectionPhoto.astro'
import { services } from '../data/site'
import photo from '../assets/services.jpg'

const offer = services.find((s) => s.popular)
const rest = services.filter((s) => !s.popular)
---

<section class="section services-section" id="services" data-stage="rose">
	<SectionPhoto src={photo} position="50% 15%" />

	<div class="container story__text">
		<span class="eyebrow reveal">Услуги и цены</span>
		<h2 class="reveal" data-delay="1">
			Сколько стоит и как проходит
		</h2>
		<p class="lead reveal" data-delay="2">
			Начните с бесплатного знакомства — после него будет понятно, какой формат вам нужен и нужен ли вообще.
		</p>

		<div class="services">
			{offer && (
				<a href="#contacts" class="offer reveal">
					<span class="offer__badge">
						<Icon name="heart" size={16} />
						Основной формат
					</span>
					<span class="offer__head">
						<span class="offer__title">{offer.title}</span>
						<span class="offer__prices">
							{offer.oldPrice && (
								<del class="offer__old">
									<span class="visually-hidden">Было </span>
									{offer.oldPrice}
								</del>
							)}
							<span class="offer__price">
								{offer.oldPrice && <span class="visually-hidden">Сейчас </span>}
								{offer.price}
							</span>
						</span>
					</span>
					<span class="offer__duration">{offer.duration}</span>
					<span class="offer__text">{offer.text}</span>
					<span class="offer__cta">
						Записаться
						<Icon name="arrow-out" class="offer__arrow" size={18} />
					</span>
				</a>
			)}

			<ol class="services__list soft-divide">
				{rest.map((s, i) => (
					<li class="service reveal" data-delay={String(i % 3)}>
						<a href="#contacts" class="service__link">
							<span class="service__icon">
								<Icon name={s.icon} class="service__glyph" size={28} />
							</span>
							<span class="service__body">
								<span class="service__title">{s.title}</span>
								<span class="service__text muted">{s.text}</span>
							</span>
							<span class="service__meta">
								{s.oldPrice && <del class="service__old muted">{s.oldPrice}</del>}
								<span class:list={['service__price', s.free && 'service__price--free']}>{s.price}</span>
								<span class="service__duration muted">{s.duration}</span>
							</span>
						</a>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.services-section {
		overflow: clip;
		padding-top: 0;
	}

	.services {
		margin-top: 48px;
	}

	/* Самую покупаемую услугу видно сразу, как "популярный тариф": не строка списка, а
	   светлая карточка, которая дышит тем же светом, что главная кнопка первого экрана.
	   Фон чуть прозрачный и размыт, как у шапки, а светлая рамка с бликом сверху
	   отделяет карточку от фона, раз заливка уже не сплошная. */
	.offer {
		position: relative;
		display: grid;
		gap: 10px;
		margin-bottom: 24px;
		padding: 26px 24px 24px;
		border-radius: 24px;
		background: color-mix(in srgb, var(--btn-bg) 82%, transparent);
		backdrop-filter: blur(14px);
		color: var(--btn-fg);
		text-decoration: none;
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.85),
			inset 0 1.5px 0 #fff,
			0 0 18px 0 color-mix(in srgb, var(--accent) 40%, transparent);
		transition:
			transform 0.5s var(--ease),
			background-color 0.6s var(--ease);

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
			box-shadow: 0 0 50px 8px color-mix(in srgb, var(--accent) 60%, transparent);
			opacity: 0;
			pointer-events: none;
			animation: offer-glow 8s ease-in-out infinite;
		}
	}

	@keyframes offer-glow {
		50% {
			opacity: 1;
		}
	}

	.offer {
		&:hover,
		&:focus-visible {
			background: color-mix(in srgb, var(--btn-hover) 92%, transparent);
			transform: translateY(-3px);
		}

		&__badge {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			width: fit-content;
			padding: 6px 12px;
			border-radius: 999px;
			/* Тёмной плашкой здесь уже кнопка: метка в цвете цены, чтобы с ней не спорить. */
			background: color-mix(in srgb, #a5573f 13%, transparent);
			box-shadow: inset 0 0 0 1px color-mix(in srgb, #a5573f 35%, transparent);
			color: #a5573f;
			font-size: 0.7rem;
			font-weight: 500;
			letter-spacing: 0.16em;
			text-transform: uppercase;
		}

		&__head {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: space-between;
			gap: 4px 16px;
			margin-top: 6px;
		}

		&__title,
		&__price {
			font-family: var(--font-serif);
			line-height: 1.1;
		}

		&__title {
			font-size: clamp(1.7rem, 4vw, 2.2rem);
		}

		&__prices {
			display: inline-flex;
			align-items: baseline;
			gap: 10px;
		}

		&__price {
			font-size: clamp(1.5rem, 3.4vw, 1.9rem);
			color: #a5573f;
		}
	}

	.offer__old,
	.service__old {
		font-family: var(--font-serif);
		text-decoration-thickness: 1.5px;
	}

	.offer {
		&__old {
			font-size: 1.1rem;
			opacity: 0.55;
		}
	}

	.service {
		&__old {
			font-size: 1rem;
		}
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.offer {
		&__duration {
			font-size: 0.8rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			opacity: 0.7;
		}

		&__text {
			max-width: 52ch;
			font-size: 0.97rem;
			opacity: 0.85;
		}

		&__cta {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			margin-top: 8px;
			padding: 0.9em 1.6em;
			border-radius: 999px;
			background: var(--btn-fg);
			color: var(--btn-bg);
			font-weight: 500;
			font-size: 0.95rem;
		}

		& :global(.offer__arrow) {
			transition: transform 0.5s var(--ease);
		}

		&:hover :global(.offer__arrow) {
			transform: translate(3px, -3px);
		}
	}

	@media (min-width: 600px) {
		.offer {
			padding: 32px 36px 30px;

			&__cta {
				width: fit-content;
			}
		}
	}

	.story__text {
		position: relative;
		z-index: 2;
	}

	.services {
		&__list {
			list-style: none;
			margin: 0;
			padding: 0;
		}
	}

	.service {
		/* На телефоне иконка в строку с названием, описание и цена под ними. */
		&__link {
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: start;
			gap: 8px 12px;
			padding: 26px 12px;
			margin-inline: -12px;
			border-radius: 12px;
			text-decoration: none;
			transition: background-color 0.4s var(--ease);
		}

		&__link:hover,
		&__link:focus-visible {
			background: color-mix(in srgb, var(--accent) 10%, transparent);
		}

		&__icon {
			display: grid;
			color: var(--accent);
			transition: color 1.4s var(--ease);
		}

		& :global(.service__glyph) {
			width: 1.6rem;
			height: 1.6rem;
		}

		&__body {
			display: contents;
		}

		&__title {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 12px;
			font-family: var(--font-serif);
			font-size: 1.5rem;
			line-height: 1.15;
		}

		&__text {
			grid-column: 1 / -1;
			display: block;
			font-size: 0.93rem;
			max-width: 44ch;
		}

		&__meta {
			grid-column: 1 / -1;
			display: flex;
			align-items: baseline;
			gap: 14px;
		}

		&__price {
			font-family: var(--font-serif);
			font-size: 1.35rem;
		}

		/* «Бесплатно» -- не цена, а повод написать: плашка заметнее цифр. */
		&__price--free {
			padding: 0.15em 0.7em 0.2em;
			border-radius: 999px;
			background: var(--btn-bg);
			color: var(--btn-fg);
			font-size: 1.1rem;
			box-shadow: 0 0 16px 0 color-mix(in srgb, var(--accent) 45%, transparent);
		}

		&__duration {
			font-size: 0.8rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}
	}

	@media (min-width: 900px) {
		.services-section {
			padding-top: var(--section-y);
		}

		.service {
			&__link {
				grid-template-columns: 52px 1fr auto;
				align-items: start;
				gap: 8px 16px;
			}

			&__icon {
				padding-top: 0.2em;
			}

			& :global(.service__glyph) {
				width: 28px;
				height: 28px;
			}

			&__body {
				display: block;
			}

			&__text {
				grid-column: auto;
				margin-top: 8px;
			}

			&__meta {
				grid-column: 3;
				flex-direction: column;
				align-items: flex-end;
				gap: 4px;
				text-align: right;
			}
		}
	}
</style>
