---
import { Image } from 'astro:assets';
import { about } from '../data/site';
import reading from '../assets/reading.webp';
---

<section class="section section--tinted" id="about">
  <div class="container about">
    <div>
      <span class="eyebrow">Обо мне</span>
      <h2>Место, где можно быть&nbsp;разной</h2>
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <div class="aside">
      <Image class="aside__photo" src={reading} alt="Татьяна с книгой" widths={[480, 960]} sizes="(min-width: 900px) 480px, 100vw" />
      <div class="education">
        <h3>Образование</h3>
        <ol>
          {about.education.map((item) => (
            <li>
              <span class="education__year">{item.year}</span>
              <span>{item.title}</span>
            </li>
          ))}
        </ol>
        <ul class="profiles">
          {about.profiles.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer">{p.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 48px;
  }

  .education {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 40px);
    box-shadow: var(--shadow);
  }

  .aside {
    display: grid;
    gap: 24px;
  }

  .aside :global(.aside__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 70%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .profiles {
    list-style: none;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.9rem;
  }

  .profiles li {
    display: block;
    padding: 0;
    border: 0;
  }

  .profiles a {
    color: var(--accent);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  li:first-child {
    border-top: 0;
  }

  .education__year {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--accent);
    line-height: 1.3;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1.1fr 1fr;
      gap: 72px;
      align-items: start;
    }
  }
</style>
