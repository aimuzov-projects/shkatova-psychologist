---
import Icon from '#/components/Icon.astro'
import { contacts } from '#/data/site.ts'
import { enabled as chatEnabled } from '#/data/chat.ts'
import { encodePhone } from '#/lib/phone.ts'

const items = [
	{ title: 'Telegram', icon: 'plane', ...contacts.telegram, external: true },
	{ title: 'ВКонтакте', icon: 'people', ...contacts.vk, external: true },
	{ title: 'Телефон', icon: 'phone', ...contacts.phone, external: false, reveal: 'tel' },
	{ title: 'WhatsApp', icon: 'chat', ...contacts.whatsapp, external: true, reveal: 'whatsapp' },
] as const
---

<section class="section contacts" id="contacts" data-stage="day">
	<div class="container contacts__inner">
		<span class="eyebrow reveal">Контакты</span>
		<h2 class="reveal" data-delay="1">
			Напишите, как получится
		</h2>
		<p class="lead reveal" data-delay="2">
			Не нужно формулировать красиво: «мне тяжело» — уже достаточно. Отвечу в течение дня и подберём время
			для бесплатных 20 минут знакомства.
		</p>

		{chatEnabled && (
			<a href="/chat/" class="ask reveal" data-delay="3">
				<span class="ask__icon" aria-hidden="true">
					<Icon name="chat" size={26} />
				</span>
				<span class="ask__text">
					<span class="ask__title">Сложно сформулировать запрос?</span>
					<span class="ask__lead">
						Расскажите о себе моему ассистенту — в своём темпе, без звонков и неловкости. Он задаст пару
						вопросов, а я прочитаю и сама напишу вам, уже понимая, что вас волнует.
					</span>
				</span>
				<span class="btn ask__btn">
					Рассказать о себе
					<Icon name="arrow-out" size={18} />
				</span>
			</a>
		)}

		<ul class="links reveal" data-delay="3">
			{items.map((i) => {
				// Номер в разметку не попадает: ссылку и подпись собирает phone-reveal.ts, а без скриптов пункта нет.
				const secret = 'reveal' in i
				return (
					<li {...(secret ? { 'data-phone-item': '', hidden: true } : {})}>
						<a
							class="links__link"
							{...(secret
								? { 'data-phone': encodePhone(i.phone), 'data-phone-href': i.reveal }
								: { href: i.href })}
							{...(i.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						>
							<span class="links__title muted">
								<Icon name={i.icon} size={22} class="links__icon" />
								{i.title}
							</span>
							<span class="links__value selectable" {...(secret ? { 'data-phone-label': '' } : {})}>
								{secret ? '' : i.label}
							</span>
							<span class="links__go" aria-hidden="true">
								<Icon name="arrow-out" size={22} />
							</span>
						</a>
					</li>
				)
			})}
		</ul>
	</div>
</section>

<script>
	import '#/lib/phone-reveal.ts'
</script>

<style>
	.links {
		display: grid;
		gap: 12px;
		margin: 40px 0 0;
		padding: 0;
		list-style: none;

		/* Два столбца: пункты идут сверху вниз, мессенджеры слева, номер справа. */
		@media (--md) {
			grid-template-rows: auto auto;
			grid-auto-flow: column;
			grid-auto-columns: 1fr;
			gap: 16px;
		}

		/* Карточки как у входа в чат, только тише: без них контакты читались простым текстом. */
		&__link {
			display: grid;
			grid-template-columns: 1fr auto;
			gap: 6px 20px;
			align-items: center;
			height: 100%;
			padding: 22px 24px;
			border-radius: 20px;
			text-decoration: none;
			background: color-mix(in srgb, var(--fg) 7%, transparent);
			box-shadow: inset 0 0 0 1px var(--line);
			transition:
				background-color 0.4s var(--ease),
				transform 0.5s var(--ease);
		}

		&__link:hover,
		&__link:focus-visible {
			transform: translateY(-2px);
			background: color-mix(in srgb, var(--accent) 14%, transparent);
		}

		/* Стрелка видна всегда, чтобы карточку узнавали как ссылку; на наведении встаёт на место. */
		&__go {
			transform: translate(-4px, 4px);
			grid-column: 2;
			grid-row: 1 / span 2;
			color: var(--accent);
			opacity: 0.45;
			transition:
				opacity 0.4s var(--ease),
				transform 0.5s var(--ease),
				color 1.4s var(--ease);
		}

		&__link:hover .links__go,
		&__link:focus-visible .links__go {
			transform: none;
			opacity: 1;
		}

		&__value {
			width: fit-content;
			font-family: var(--font-serif);
			font-size: clamp(1.4rem, 3.4vw, 2rem);
			line-height: 1.2;
			/* Телефон рвётся на дефисах, а неразрывный пробел их не держит. */
			white-space: nowrap;
			background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1px;
			transition: background-size 0.5s var(--ease);
		}

		&__link:hover .links__value,
		&__link:focus-visible .links__value {
			background-size: 100% 1px;
		}

		& :global(.links__icon) {
			transition: color 0.4s var(--ease);
		}

		&__link:hover :global(.links__icon) {
			color: var(--accent);
		}

		&__title {
			display: inline-flex;
			gap: 12px;
			align-items: center;
			font-size: 0.78rem;
			text-transform: uppercase;
			letter-spacing: 0.18em;
		}
	}

	/* Вход в чат: карточка целиком кликабельна, кнопка дышит как главная в Hero. */
	.ask {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 18px 20px;
		align-items: center;
		margin-top: 40px;
		padding: 28px;
		border-radius: 28px;
		text-decoration: none;
		background: color-mix(in srgb, var(--fg) 12%, transparent);
		box-shadow: inset 0 0 0 1px var(--line);
		transition:
			background-color 0.5s var(--ease),
			transform 0.5s var(--ease);

		@media (--below-sm) {
			grid-template-columns: 1fr;
			padding: 24px;
		}

		@media (--md) {
			grid-template-columns: auto 1fr auto;
			gap: 28px;
			padding: 32px 36px;
		}

		&:hover,
		&:focus-visible {
			transform: translateY(-2px);
			background: color-mix(in srgb, var(--fg) 18%, transparent);
		}

		&__icon {
			display: grid;
			place-items: center;
			width: 56px;
			height: 56px;
			border-radius: 50%;
			color: var(--accent);
			background: color-mix(in srgb, var(--accent) 22%, transparent);
		}

		&__text {
			display: grid;
			gap: 6px;
		}

		&__title {
			font-family: var(--font-serif);
			font-size: clamp(1.5rem, 3vw, 2rem);
			line-height: 1.15;
		}

		&__lead {
			max-width: 52ch;
			color: var(--muted);
			transition: color 1.4s var(--ease);
		}

		&__btn {
			position: relative;
			grid-column: 1 / -1;
			justify-self: start;
			box-shadow: 0 0 14px 0 color-mix(in srgb, var(--accent) 35%, transparent);

			@media (--below-sm) {
				justify-content: center;
				justify-self: stretch;
			}

			@media (--md) {
				grid-column: auto;
			}
		}

		&__btn::after {
			pointer-events: none;
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
			opacity: 0;
			box-shadow: 0 0 44px 10px color-mix(in srgb, var(--accent) 70%, transparent);
			animation: ask-glow 8s ease-in-out infinite;

			@media (--reduced-motion) {
				animation: none;
			}
		}

		&:hover .ask__btn {
			background: var(--btn-hover);
		}
	}

	@keyframes ask-glow {
		50% {
			opacity: 1;
		}
	}

	/* Над горами из футера, которые поднимаются под контакты. */
	.contacts__inner {
		position: relative;
		z-index: 1;
	}
</style>
