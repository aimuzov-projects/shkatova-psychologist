---
// Тонкие линейные иконки в одном стиле, рисуются currentColor.
interface Props {
	name: keyof typeof icons
	size?: number
	class?: string
}

const icons = {
	belly: '<circle cx="12" cy="13" r="8"/><circle cx="12" cy="13" r="2.5"/><path d="M12 3v2"/>',
	sunrise: '<path d="M3 18h18"/><path d="M6 18a6 6 0 0 1 12 0"/><path d="M12 4v3M5.5 7.5l2 2M18.5 7.5l-2 2"/>',
	candle: '<path d="M8 21h8"/><path d="M10 11h4v10h-4z"/><path d="M12 8c-1.3-1.4-1.3-2.9 0-4.5 1.3 1.6 1.3 3.1 0 4.5z"/>',
	sprout: '<path d="M12 21v-8"/><path d="M12 13c0-4.2 3-6.5 7.5-6.5 0 4.2-3 6.5-7.5 6.5z"/><path d="M12 16c0-3-2.3-5-5.5-5 0 3 2.3 5 5.5 5z"/>',
	moon: '<path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/><path d="M17.5 3l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>',
	book: '<path d="M12 7c-2-1.6-4.6-2.2-8-2.2v13.4c3.4 0 6 .6 8 2.2 2-1.6 4.6-2.2 8-2.2V4.8c-3.4 0-6 .6-8 2.2z"/><path d="M12 7v13.4"/>',
	plane: '<path d="M21 3L3 10.5l7.5 3L13.5 21z"/><path d="M21 3l-10.5 10.5"/>',
	chat: '<path d="M4 19l1.4-3.6A8 8 0 1 1 8.6 18.6z"/>',
	phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
	spark: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>',
	heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
	'arrow-out': '<path d="M7 17L17 7"/><path d="M9 7h8v8"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
	screen: '<rect x="3.5" y="5" width="17" height="11" rx="2"/><path d="M9 20h6M12 16v4"/>',
	lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>',
	stroller:
		'<path d="M4 6h2.5l2 9h9.5"/><path d="M8.5 13.5C8.5 9 11 6.5 15 6.5c2.5 0 4 1.5 4 3.5v3.5"/><circle cx="9.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/>',
	calendar:
		'<rect x="4" y="5.5" width="16" height="14.5" rx="2.5"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/><path d="M12 13.2l.6 1.3 1.4.2-1 1 .2 1.4-1.2-.7-1.2.7.2-1.4-1-1 1.4-.2z"/>',
	'arrow-up': '<path d="M12 20V4"/><path d="M6 10l6-6 6 6"/>',
	cross: '<path d="M7 7l10 10M17 7L7 17"/>',
	check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
	arrow: '<path d="M12 4v16"/><path d="M6 14l6 6 6-6"/>',
	people: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7"/><path d="M17.5 14.5a6 6 0 0 1 3.5 5.5"/>',
}

export type IconName = keyof typeof icons

const { name, size = 28, class: className } = Astro.props
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={size > 64 ? 1 : 1.4}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={icons[name]}
/>
