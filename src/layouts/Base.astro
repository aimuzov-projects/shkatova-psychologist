---
import '@fontsource/prata/400.css'
import '@fontsource/golos-text/400.css'
import '@fontsource/golos-text/500.css'
import prataCyr from '@fontsource/prata/files/prata-cyrillic-400-normal.woff2?url'
import prataLat from '@fontsource/prata/files/prata-latin-400-normal.woff2?url'
import golosCyr from '@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url'
import golosCyr500 from '@fontsource/golos-text/files/golos-text-cyrillic-500-normal.woff2?url'
import golosLat from '@fontsource/golos-text/files/golos-text-latin-400-normal.woff2?url'
import golosLat500 from '@fontsource/golos-text/files/golos-text-latin-500-normal.woff2?url'
import golosLatExt from '@fontsource/golos-text/files/golos-text-latin-ext-400-normal.woff2?url'
import '#/styles/global.css'
import og from '#/assets/og.jpg'
import { person } from '#/data/site.ts'

// Шрифты свои и в preload, иначе текст рисуется запасным и прыгает.
// latin-ext нужен ради знака ₽ в ценах, но без preload он грузится цепочкой
// после CSS.
const preload = [prataCyr, prataLat, golosCyr, golosCyr500, golosLat, golosLat500, golosLatExt]

type Props = {
	/** `<title>` и `og:title`, по умолчанию "имя — роль" из `person`. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `person.intro`. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
}

const {
	title = `${person.name} — ${person.role.toLowerCase()}`,
	description = person.intro,
	index = true,
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru" class="page" data-stage="night">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		{/* Карточка ссылки в мессенджерах. og.jpg вырезан из hero.jpg в пропорции 1.91:1 лицом по центру:
		    снимки вертикальные, а автоматическая обрезка ловила статуэтку вместо лица. */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={person.name} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(og.src, Astro.site)} />
		<meta property="og:image:width" content={String(og.width)} />
		<meta property="og:image:height" content={String(og.height)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#211320" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<slot name="head" />
		{preload.map((href) => (
			<link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
		))}

		{/* Яндекс.Метрика. Скрипт счётчика (~85 КБ) на мобильном отнимал канал у шрифтов
		    и первого фото, поэтому грузим его по первому действию или через 4 с после load,
		    вызовы ym до того ждут в очереди. Вебвизор выключен: на мобильном он поднимал LCP
		    с ~2.1 до ~3 с. Комментарии здесь, а не в скрипте: is:inline уходит в HTML как есть. */}
		<script is:inline>
			;(function (m, e, t, r, i, k, a) {
				m[i] =
					m[i] ||
					function () {
						;(m[i].a = m[i].a || []).push(arguments)
					}
				m[i].l = 1 * new Date()
				for (var j = 0; j < document.scripts.length; j++) {
					if (document.scripts[j].src === r) {
						return
					}
				}
				var events = ['scroll', 'pointerdown', 'keydown', 'touchstart']
				var load = function () {
					if (k) return
					events.forEach(function (name) {
						m.removeEventListener(name, load)
					})
					k = e.createElement(t)
					a = e.getElementsByTagName(t)[0]
					k.async = 1
					k.src = r
					a.parentNode.insertBefore(k, a)
				}
				events.forEach(function (name) {
					m.addEventListener(name, load, { passive: true })
				})
				var later = function () {
					setTimeout(load, 4000)
				}
				if (e.readyState === 'complete') later()
				else m.addEventListener('load', later)
			})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=113579697', 'ym')

			ym(113579697, 'init', {
				ssr: true,
				webvisor: false,
				clickmap: true,
				ecommerce: 'dataLayer',
				referrer: document.referrer,
				url: location.href,
				accurateTrackBounce: true,
				trackLinks: true,
			})
		</script>
	</head>
	<body>
		<noscript>
			<div>
				<img src="https://mc.yandex.ru/watch/113579697" style="position:absolute; left:-9999px;" alt="" />
			</div>
		</noscript>
		<div class="glow" aria-hidden="true" />
		<slot />

		<script>
			import { everyFrame, onResize, reduceMotion } from '#/lib/frame.ts'

			// Здесь только то, что касается страницы целиком. Эффекты отдельных секций живут
			// в своих компонентах и регистрируются в общем кадре #/lib/frame.ts.
			const root = document.documentElement

			/**
			 * Ссылки на якоря внутри страницы крутят сами и адрес не трогают: якорь в адресе
			 * ломает рефреш, браузер восстанавливает прокрутку, а потом ещё и плавно едет к якорю.
			 */
			function initAnchorScroll() {
				document.addEventListener('click', (e) => {
					const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]')
					if (!link || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return
					const target = document.getElementById(link.hash.slice(1))
					if (!target) return
					e.preventDefault()
					const behavior = reduceMotion ? 'auto' : 'smooth'
					if (target.id === 'top') scrollTo({ top: 0, behavior })
					else target.scrollIntoView({ behavior })
				})
			}

			/** Стадия суток: секция, занявшая середину экрана, ставит свою `data-stage` на `<html>`. */
			function initStages() {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting)
								root.dataset.stage = (e.target as HTMLElement).dataset.stage ?? 'night'
						}
					},
					{ rootMargin: '-45% 0px -45% 0px' },
				)
				document.querySelectorAll<HTMLElement>('[data-stage]').forEach((el) => observer.observe(el))
			}

			/** Блоки `.reveal` проявляются один раз, когда показались на экране хотя бы на 15%. */
			function initReveal() {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue
							e.target.classList.add('reveal--in')
							observer.unobserve(e.target)
						}
					},
					{ threshold: 0.15 },
				)
				document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))
			}

			type Stop = { y: number; color: string }

			/** Светлый ли цвет, по яркости. В сборке минификатор сокращает цвета: `#ffffff` приходит как `#fff`. */
			function isLight(hex: string) {
				if (hex.length < 7) hex = '#' + hex.slice(1, 4).replace(/./g, '$&$&')
				const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16))
				return 0.2126 * r + 0.7152 * g + 0.0722 * b > 140
			}

			/**
			 * Опорные точки градиента по секциям. Если у соседей текст одного тона, цвет перетекает
			 * от середины к середине; если тон меняется -- только в зазоре, не шире отступов,
			 * чтобы не заходить под текст.
			 */
			function measureStops(sections: HTMLElement[]): Stop[] {
				const items = sections.map((el) => {
					const box = el.getBoundingClientRect()
					const style = getComputedStyle(el)
					return {
						top: box.top + scrollY,
						mid: box.top + scrollY + box.height / 2,
						padTop: parseFloat(style.paddingTop),
						padBottom: parseFloat(style.paddingBottom),
						color: style.getPropertyValue('--bg').trim(),
						lightText: isLight(style.getPropertyValue('--fg').trim()),
					}
				})
				const stops = [{ y: 0, color: items[0].color }]
				items.slice(1).forEach((b, i) => {
					const a = items[i]
					if (a.lightText === b.lightText)
						stops.push({ y: a.mid, color: a.color }, { y: b.mid, color: b.color })
					else {
						const seam = Math.min(a.padBottom, b.padTop, 90)
						stops.push({ y: b.top - seam, color: a.color }, { y: b.top + seam, color: b.color })
					}
				})
				return stops
			}

			/** Цвет градиента в точке страницы `y`: до первой точки и после последней цвет не меняется. */
			function colorAt(stops: Stop[], y: number) {
				const next = stops.findIndex((stop) => stop.y > y)
				if (next === -1) return stops.at(-1)!.color
				if (next === 0) return stops[0].color
				const a = stops[next - 1]
				const b = stops[next]
				const t = (y - a.y) / (b.y - a.y || 1)
				return `color-mix(in oklab, ${b.color} ${(t * 100).toFixed(1)}%, ${a.color})`
			}

			/**
			 * Фон страницы -- один градиент через все секции, пересчитывается после раскладки.
			 * Тем же цветом в середине экрана красится затемнение на фото в колонке Story: переменная
			 * на `<html>` пересчитывала бы стили всей страницы на каждом кадре. У страницы-презентации
			 * секций нет, фон она красит сама.
			 */
			function initBackground() {
				const sections = [...document.querySelectorAll<HTMLElement>('body [data-stage]')]
				if (!sections.length) return
				let stops: Stop[] = []

				onResize(() => {
					stops = measureStops(sections)
					const list = stops.map(({ y, color }) => `${color} ${Math.round(y)}px`).join(', ')
					// Ниже последней точки фон держит цвет последней секции.
					const last = stops.at(-1)!.color
					return () =>
						(document.body.style.backgroundImage = `linear-gradient(in oklab to bottom, ${list}, ${last})`)
				})

				const storyVeil = document.querySelector<HTMLElement>('[data-veil="story"]')
				if (storyVeil)
					everyFrame(() => {
						const y = scrollY + innerHeight / 2
						return () => stops.length && (storyVeil.style.backgroundColor = colorAt(stops, y))
					})
			}

			/** Класс `page--scrolled` на `<html>`, как только страницу сдвинули больше чем на 40px. */
			function initScrolledFlag() {
				everyFrame(() => {
					const scrolled = scrollY > 40
					return () => root.classList.toggle('page--scrolled', scrolled)
				})
			}

			/** Пятно света `.glow` за курсором. Только мышь и только без "уменьшения движения". */
			function initCursorGlow() {
				const glow = document.querySelector<HTMLElement>('.glow')
				if (!glow || reduceMotion || !matchMedia('(pointer: fine)').matches) return
				addEventListener(
					'pointermove',
					(e) => {
						glow.style.setProperty('--x', `${e.clientX}px`)
						glow.style.setProperty('--y', `${e.clientY}px`)
					},
					{ passive: true },
				)
			}

			initAnchorScroll()
			initStages()
			initReveal()
			initBackground()
			initScrolledFlag()
			initCursorGlow()
		</script>
	</body>
</html>
