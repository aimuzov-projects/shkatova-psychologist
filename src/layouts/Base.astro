---
import '@fontsource/prata/400.css'
import '@fontsource/golos-text/400.css'
import '@fontsource/golos-text/500.css'
import prataCyr from '@fontsource/prata/files/prata-cyrillic-400-normal.woff2?url'
import prataLat from '@fontsource/prata/files/prata-latin-400-normal.woff2?url'
import golosCyr from '@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url'
import golosCyr500 from '@fontsource/golos-text/files/golos-text-cyrillic-500-normal.woff2?url'
import golosLat from '@fontsource/golos-text/files/golos-text-latin-400-normal.woff2?url'
import golosLat500 from '@fontsource/golos-text/files/golos-text-latin-500-normal.woff2?url'
import golosLatExt from '@fontsource/golos-text/files/golos-text-latin-ext-400-normal.woff2?url'
import '../styles/global.css'
import { person } from '../data/site'

// Шрифты свои и в preload, иначе текст рисуется запасным и прыгает.
// latin-ext нужен ради знака ₽ в ценах, но без preload он грузится цепочкой
// после CSS.
const preload = [prataCyr, prataLat, golosCyr, golosCyr500, golosLat, golosLat500, golosLatExt]

interface Props {
	title?: string
	description?: string
}

const { title = `${person.name} — ${person.role.toLowerCase()}`, description = person.intro } = Astro.props
---

<!doctype html>
<html lang="ru" data-stage="night">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="theme-color" content="#211320" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{preload.map((href) => (
			<link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
		))}

		<!-- Yandex.Metrika counter -->
		<script is:inline>
			;(function (m, e, t, r, i, k, a) {
				m[i] =
					m[i] ||
					function () {
						;(m[i].a = m[i].a || []).push(arguments)
					}
				m[i].l = 1 * new Date()
				for (var j = 0; j < document.scripts.length; j++) {
					if (document.scripts[j].src === r) {
						return
					}
				}
				// Скрипт счётчика (~85 КБ) на мобильном отнимал канал у шрифтов и первого фото.
				// Грузим по первому действию или через 4 с после load, вызовы ym до того ждут в очереди.
				var events = ['scroll', 'pointerdown', 'keydown', 'touchstart']
				var load = function () {
					if (k) return
					events.forEach(function (name) {
						m.removeEventListener(name, load)
					})
					;((k = e.createElement(t)),
						(a = e.getElementsByTagName(t)[0]),
						(k.async = 1),
						(k.src = r),
						a.parentNode.insertBefore(k, a))
				}
				events.forEach(function (name) {
					m.addEventListener(name, load, { passive: true })
				})
				var later = function () {
					setTimeout(load, 4000)
				}
				if (e.readyState === 'complete') later()
				else m.addEventListener('load', later)
			})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=113579697', 'ym')

			ym(113579697, 'init', {
				ssr: true,
				// Вебвизор выключен: на мобильном он поднимал LCP с ~2.1 до ~3 с.
				webvisor: false,
				clickmap: true,
				ecommerce: 'dataLayer',
				referrer: document.referrer,
				url: location.href,
				accurateTrackBounce: true,
				trackLinks: true,
			})
		</script>
		<!-- /Yandex.Metrika counter -->
	</head>
	<body>
		<noscript>
			<div>
				<img src="https://mc.yandex.ru/watch/113579697" style="position:absolute; left:-9999px;" alt="" />
			</div>
		</noscript>
		<div class="glow" aria-hidden="true"></div>
		<slot />

		<script>
			const root = document.documentElement
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

			// Якорь в адресе ломает рефреш: браузер восстанавливает прокрутку, а потом плавно
			// едет к якорю. Поэтому ссылки внутри страницы крутят сами и адрес не трогают.
			document.addEventListener('click', (e) => {
				const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]')
				if (!link || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return
				const target = document.getElementById(link.hash.slice(1))
				if (!target) return
				e.preventDefault()
				const behavior = reduce ? 'auto' : 'smooth'
				if (target.id === 'top') scrollTo({ top: 0, behavior })
				else target.scrollIntoView({ behavior })
			})

			// Стадия суток: секция, занявшая середину экрана, красит всю страницу.
			const stageObserver = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) root.dataset.stage = (e.target as HTMLElement).dataset.stage ?? 'night'
					}
				},
				{ rootMargin: '-45% 0px -45% 0px' },
			)
			document.querySelectorAll<HTMLElement>('[data-stage]').forEach((el) => stageObserver.observe(el))

			const revealObserver = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue
						e.target.classList.add('is-in')
						revealObserver.unobserve(e.target)
					}
				},
				{ threshold: 0.15 },
			)
			document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el))

			// Каждый measure* только читает геометрию и возвращает запись в DOM. Кадр сначала
			// меряет всё, потом всё пишет: чтение после записи заставляло бы браузер
			// раскладывать страницу заново на каждый замер.
			type Write = () => void

			// Параллакс: сдвиг пропорционален расстоянию обёртки до центра экрана.
			const parallax = [...document.querySelectorAll<HTMLElement>('[data-parallax]')]
			let ticking = false
			const measureParallax = (): Write => {
				const mid = innerHeight / 2
				const offsets = parallax.map((el) => {
					const box = (el.parentElement as HTMLElement).getBoundingClientRect()
					return (box.top + box.height / 2 - mid) * Number(el.dataset.parallax)
				})
				return () => parallax.forEach((el, i) => (el.style.transform = `translate3d(0, ${offsets[i].toFixed(1)}px, 0)`))
			}

			// Активно последнее фото, чья линия пройдена; вуаль густеет до следующего.
			const stories = [...document.querySelectorAll<HTMLElement>('.story')].map((story) => ({
				story,
				veil: story.querySelector<HTMLElement>('[data-veil="story"]'),
				shots: [...story.querySelectorAll<HTMLElement>('.story__shot')].map((el) => ({
					el,
					trigger: el.dataset.trigger ? document.querySelector<HTMLElement>(el.dataset.trigger) : null,
					at: Number(el.dataset.at ?? 0),
				})),
			}))
			const measureStories = (): Write => {
				const vh = innerHeight
				const writes = stories.map(({ story, veil, shots }): Write => {
					const box = story.getBoundingClientRect()
					const passed = shots.map(({ trigger, at }) =>
						trigger ? (at <= 1 ? vh * at : at) - trigger.getBoundingClientRect().top : -box.top,
					)
					let active = -1
					passed.forEach((p, i) => p >= 0 && (active = i))
					let opacity: string | null = null
					if (veil && active >= 0) {
						const end =
							active + 1 < passed.length ? passed[active] - passed[active + 1] : passed[active] + box.bottom - vh
						const progress = Math.min(1, Math.max(0, passed[active] / Math.max(1, end)))
						opacity = (0.35 + 0.45 * progress).toFixed(3)
					}
					return () => {
						shots.forEach(({ el }, i) => el.classList.toggle('is-active', i === active))
						if (veil && opacity) veil.style.opacity = opacity
					}
				})
				return () => writes.forEach((write) => write())
			}

			// На телефоне у секций свои фото: вуаль густеет, пока секция уезжает вверх.
			const sectionVeils = [...document.querySelectorAll<HTMLElement>('[data-veil]:not([data-veil="story"])')]
			const measureSectionVeils = (): Write => {
				const vh = innerHeight
				const opacities = sectionVeils.map((veil) => {
					const section = veil.closest('section')
					if (!section) return null
					const box = section.getBoundingClientRect()
					const progress = Math.min(1, Math.max(0, -box.top / (box.height - vh * 0.5)))
					return (0.35 + 0.45 * progress).toFixed(3)
				})
				return () => sectionVeils.forEach((veil, i) => opacities[i] && (veil.style.opacity = opacities[i]))
			}

			// Фон -- один градиент по всей странице. Если у соседей текст одного тона, цвет
			// перетекает от середины к середине; если тон текста меняется -- только в зазоре.
			const sections = [...document.querySelectorAll<HTMLElement>('body [data-stage]')]
			const isLight = (hex: string) => {
				// В сборке минификатор сокращает цвета: #ffffff приходит как #fff.
				if (hex.length < 7) hex = '#' + [...hex.slice(1, 4)].map((c) => c + c).join('')
				const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16))
				return 0.2126 * r + 0.7152 * g + 0.0722 * b > 140
			}
			let bgStops: { y: number; color: string }[] = []
			const measureBackground = (): Write => {
				// У страницы-презентации секций нет, фон красит она сама.
				if (!sections.length) return () => {}
				const items = sections.map((el) => {
					const box = el.getBoundingClientRect()
					const style = getComputedStyle(el)
					return {
						top: box.top + scrollY,
						mid: box.top + scrollY + box.height / 2,
						padTop: parseFloat(style.paddingTop),
						padBottom: parseFloat(style.paddingBottom),
						color: style.getPropertyValue('--bg').trim(),
						lightText: isLight(style.getPropertyValue('--fg').trim()),
					}
				})
				bgStops = [{ y: 0, color: items[0].color }]
				items.slice(1).forEach((b, i) => {
					const a = items[i]
					if (a.lightText === b.lightText) bgStops.push({ y: a.mid, color: a.color }, { y: b.mid, color: b.color })
					else {
						// Полоса перехода не шире отступов, чтобы не заходить под текст.
						const seam = Math.min(a.padBottom, b.padTop, 90)
						bgStops.push({ y: b.top - seam, color: a.color }, { y: b.top + seam, color: b.color })
					}
				})
				const list = bgStops.map(({ y, color }) => `${color} ${Math.round(y)}px`).join(', ')
				return () =>
					(document.body.style.backgroundImage = `linear-gradient(in oklab to bottom, ${list}, ${items.at(-1)!.color})`)
			}
			// Тот же цвет в точке страницы: им красятся шапка и вуали на фото.
			const colorAt = (y: number) => {
				const next = bgStops.findIndex((stop) => stop.y > y)
				if (next === -1) return bgStops.at(-1)!.color
				if (next === 0) return bgStops[0].color
				const a = bgStops[next - 1]
				const b = bgStops[next]
				const t = (y - a.y) / (b.y - a.y || 1)
				return `color-mix(in oklab, ${b.color} ${(t * 100).toFixed(1)}%, ${a.color})`
			}
			// Цвет нужен только затемнению на фото в колонке: переменная на <html>
			// пересчитывала бы стили всей страницы на каждом кадре.
			const storyVeil = document.querySelector<HTMLElement>('[data-veil="story"]')
			const updatePageBg = () => {
				if (storyVeil && bgStops.length) storyVeil.style.backgroundColor = colorAt(scrollY + innerHeight / 2)
			}

			// Телефон: первый экран прокручен -- шапка уезжает, а справа в угол
			// выезжает круглая кнопка записи (сама анимация -- в стилях Header.astro).
			const hero = document.querySelector<HTMLElement>('#top')
			const fab = document.querySelector<HTMLElement>('.fab')
			let pastHero = false
			const contactsSection = document.querySelector<HTMLElement>('#contacts')
			let atContacts = false
			const measureFab = (): Write | null => {
				if (!fab || !contactsSection) return null
				const next = contactsSection.getBoundingClientRect().top < innerHeight * 0.5
				if (next === atContacts) return null
				atContacts = next
				return () => {
					root.classList.toggle('at-contacts', atContacts)
					fab.setAttribute('href', atContacts ? '#top' : '#contacts')
					fab.setAttribute('aria-label', atContacts ? 'Наверх' : 'Записаться')
				}
			}

			const measureHeader = (): Write | null => {
				if (!hero) return null
				const next = hero.getBoundingClientRect().bottom < 80
				if (next === pastHero) return null
				pastHero = next
				return () => root.classList.toggle('past-hero', pastHero)
			}

			const frame = (extra: (Write | null)[] = []) => {
				const writes = [
					...extra,
					measureHeader(),
					measureFab(),
					measureStories(),
					measureSectionVeils(),
					reduce ? null : measureParallax(),
				]
				root.classList.toggle('scrolled', scrollY > 40)
				writes.forEach((write) => write?.())
				updatePageBg()
			}

			const onScroll = () => {
				if (ticking) return
				ticking = true
				requestAnimationFrame(() => {
					frame()
					ticking = false
				})
			}
			addEventListener('scroll', onScroll, { passive: true })

			// Первый кадр и пересчёт после ресайза делает ResizeObserver: он срабатывает уже
			// после раскладки, так что замеры не заставляют браузер раскладывать страницу заранее.
			new ResizeObserver(() => frame([measureBackground()])).observe(document.body)

			const glow = document.querySelector<HTMLElement>('.glow')
			if (glow && !reduce && matchMedia('(pointer: fine)').matches) {
				addEventListener(
					'pointermove',
					(e) => {
						glow.style.setProperty('--x', `${e.clientX}px`)
						glow.style.setProperty('--y', `${e.clientY}px`)
					},
					{ passive: true },
				)
			}
		</script>
	</body>
</html>
