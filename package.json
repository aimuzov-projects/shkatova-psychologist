{
	"name": "shkatova-site",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"chat": "node --watch --env-file-if-exists=.env chat/src/server.ts",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings"
	},
	"dependencies": {
		"@astrojs/svelte": "9.0.1",
		"@fontsource/golos-text": "5.3.0",
		"@fontsource/prata": "5.3.0",
		"astro": "7.3.7",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@csstools/postcss-global-data": "4.0.0",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@types/node": "24.19.2",
		"oxlint": "1.87.0",
		"postcss-custom-media": "12.0.3",
		"postcss-html": "2.0.0",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint": "17.16.0",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	},
	"imports": {
		"#/*": "./src/*"
	}
}
